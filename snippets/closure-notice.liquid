{%- comment -%}
  Christmas closure notice. Shows automatically and stops showing on 4 January 2027.
  Usage: {% render 'closure-notice' %}  (or compact: true for the slide-out basket, bar: true, message: '...' for the strip under the announcement bar; the strip's wording is editable in the theme editor)
  The basket panel wording is in Theme settings, Christmas closure panel. The strip's wording is in the Closure bar section.
{%- endcomment -%}
{%- assign cn_now = 'now' | date: '%s' | plus: 0 -%}
{%- assign cn_end = '2027-01-04 00:00:00 +0000' | date: '%s' | plus: 0 -%}
{%- if cn_now < cn_end -%}
  {{ 'closure-notice.css' | asset_url | stylesheet_tag }}
  {%- if bar -%}
    <div class="closure-bar" role="note"><p class="closure-bar__text">{%- if message != blank -%}{{ message }}{%- else -%}<strong>Christmas:</strong> we close at noon on 24 Dec and re-open 4 Jan. Non-fabricated orders arrive by 21 Dec. Fabricated orders, order by 14 Dec.{%- endif -%}</p></div>
  {%- else -%}
  {%- if settings.closure_panel_show -%}
  <div class="closure-notice{% if compact %} closure-notice--compact{% endif %}" role="note">
    <p class="closure-notice__title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      {{ settings.closure_panel_title }}
    </p>
    <ul class="closure-notice__list">
      {%- if settings.closure_line_1_text != blank -%}<li><span class="closure-notice__date">{{ settings.closure_line_1_date }}</span><span>{{ settings.closure_line_1_text }}</span></li>{%- endif -%}
      {%- if settings.closure_line_2_text != blank -%}<li><span class="closure-notice__date">{{ settings.closure_line_2_date }}</span><span>{{ settings.closure_line_2_text }}</span></li>{%- endif -%}
      {%- if settings.closure_line_3_text != blank -%}<li><span class="closure-notice__date">{{ settings.closure_line_3_date }}</span><span>{{ settings.closure_line_3_text }}</span></li>{%- endif -%}
    </ul>
  </div>
  {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Promo tiles, text + link + colour only. Drop into any Shopify theme.

  USAGE inside the product loop of your collection grid (after each product <li>):
    {% render 'promo-tiles', index0: forloop.index0, last: forloop.last, interval: 8 %}

  Collection metafields (namespace custom, all LIST types, index-aligned, up to 3 tiles):
    promo_headings  list.single_line_text_field   required, a tile shows if heading exists
    promo_texts     list.single_line_text_field   optional small line under heading
    promo_links     list.url                      optional, no link = static tile
    promo_bg        list.color                    background colour, default #082a38
    promo_fg        list.color                    text colour, default #ffffff
{%- endcomment -%}
{%- liquid
  assign heads = collection.metafields.custom.promo_headings.value
  assign texts = collection.metafields.custom.promo_texts.value
  assign links = collection.metafields.custom.promo_links.value
  assign bgs = collection.metafields.custom.promo_bg.value
  assign fgs = collection.metafields.custom.promo_fg.value
  assign n = heads.size | default: 0
-%}
{%- if n > 0 and interval > 0 and index0 > 0 and last == false -%}
  {%- assign hit = index0 | modulo: interval -%}
  {%- if hit == 0 -%}
    {%- assign slot = index0 | divided_by: interval | minus: 1 | modulo: n -%}
    {%- assign bg = bgs[slot] | default: '#082a38' -%}
    {%- assign fg = fgs[slot] | default: '#ffffff' -%}
    <li class="grid__item promo-tile-item">
      <{% if links[slot] != blank %}a href="{{ links[slot] }}"{% else %}div{% endif %}
        class="promo-tile" style="--promo-bg:{{ bg }};--promo-fg:{{ fg }}">
        <span class="promo-tile__heading">{{ heads[slot] }}</span>
        {%- if texts[slot] != blank -%}<span class="promo-tile__text">{{ texts[slot] }}</span>{%- endif -%}
        {%- if links[slot] != blank -%}<span class="promo-tile__cta" aria-hidden="true">Shop now &rarr;</span>{%- endif -%}
      </{% if links[slot] != blank %}a{% else %}div{% endif %}>
    </li>
    <style>
      .promo-tile-item { display: flex; }
      .promo-tile { display: flex; flex-direction: column; justify-content: center; gap: 10px; width: 100%; aspect-ratio: 1 / 1; padding: 28px; box-sizing: border-box; border-radius: var(--radius, 8px); background: var(--promo-bg); color: var(--promo-fg); text-decoration: none; }
      .promo-tile__heading { font-weight: 700; font-size: clamp(20px, 2.4vw, 30px); line-height: 1.15; }
      .promo-tile__text { font-size: 15px; line-height: 1.4; opacity: .9; }
      .promo-tile__cta { margin-top: 6px; font-weight: 700; font-size: 14px; }
      a.promo-tile:hover .promo-tile__cta { text-decoration: underline; }
    </style>
  {%- endif -%}
{%- endif -%}

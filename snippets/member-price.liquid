{%- comment -%}
  Member price line for signed-in customers tagged `trade` (15%) or `club-vivid` (10%).
  Must match the automatic discounts in Shopify admin (Trade 15% off, Club VIVID 10% off),
  which exclude products tagged Clearance and any product with a compare-at price.
  Params: product, variant (optional, defaults to selected_or_first_available), dom_id (optional, PDP only).
{%- endcomment -%}
{%- liquid
  assign mp_pct = 0
  assign mp_label = ''
  if customer
    if customer.tags contains 'trade'
      assign mp_pct = 15
      assign mp_label = 'Trade price'
    elsif customer.tags contains 'club-vivid'
      assign mp_pct = 10
      assign mp_label = 'Club VIVID price'
    endif
  endif
  assign mp_variant = variant | default: product.selected_or_first_available_variant
  assign mp_ok = true
  if product.tags contains 'Clearance' or mp_variant.compare_at_price > mp_variant.price
    assign mp_ok = false
  endif
-%}
{%- if mp_pct > 0 and mp_ok -%}
  {%- assign mp_off = mp_variant.price | times: mp_pct | divided_by: 100 -%}
  {%- assign mp_final = mp_variant.price | minus: mp_off -%}
  <p class="vd-member"{% if dom_id %} id="{{ dom_id }}"{% endif %} data-member-pct="{{ mp_pct }}" data-member-label="{{ mp_label }}">
    {{ mp_label }}{% if product.price_varies and dom_id == blank %} from{% endif %} <strong>{{ mp_final | money }}</strong>
  </p>
{%- elsif mp_ok and customer == nil and dom_id != blank -%}
  <p class="vd-member vd-member--teaser" id="{{ dom_id }}">
    <a href="{{ routes.account_login_url }}">Sign in</a> to see your Club VIVID or trade price
  </p>
{%- endif -%}

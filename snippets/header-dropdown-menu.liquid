{% comment %}
  Renders a standard dropdown style menu for the header.

  Usage:
  {% render 'header-dropdown-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}
          {%- comment -%} Optional featured tile: a 'menu_feature' header block whose
              menu_handle matches this top-level item's handle, OR the handle of
              any of its dropdown children (e.g. a specific brand inside "Brands") {%- endcomment -%}
          {%- assign _feat = blank -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'menu_feature' and block.settings.menu_handle != blank -%}
              {%- assign _mh = block.settings.menu_handle | strip | downcase -%}
              {%- if _mh == link.handle -%}
                {%- assign _feat = block -%}
              {%- else -%}
                {%- for childlink in link.links -%}
                  {%- assign _ct = childlink.title | strip | downcase -%}
                  {%- if _mh == childlink.handle or _mh == _ct -%}
                    {%- assign _feat = block -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div
                id="HeaderMenu-MenuList-{{ forloop.index }}"
                class="header__submenu m-mega{% if _feat != blank %} m-mega--has-feature{% endif %} motion-reduce"
                tabindex="-1"
              >
                <ul class="m-mega__links" role="list">
                  {%- for childlink in link.links -%}
                    {%- comment -%} Icon: only shown when an explicit 'menu_icon' header
                        block matches this item's name or handle — no automatic guessing,
                        so items without an override render identically (no icon). {%- endcomment -%}
                    {%- assign _t = childlink.title | downcase -%}
                    {%- assign _icon = '' -%}
                    {%- for iblock in section.blocks -%}
                      {%- if iblock.type == 'menu_icon' and iblock.settings.match != blank -%}
                        {%- assign _m = iblock.settings.match | strip | downcase -%}
                        {%- if _m == _t or _m == childlink.handle -%}
                          {%- unless iblock.settings.icon == 'none' -%}{%- assign _icon = iblock.settings.icon -%}{%- endunless -%}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                    <li class="m-mega__col">
                      <a
                        id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="m-mega__link{% unless _icon != blank %} m-mega__link--plain{% endunless %}{% if childlink.current %} is-current{% endif %}"
                        {% if childlink.current %}aria-current="page"{% endif %}
                      >
                        {%- if _icon != blank -%}<span class="m-mega__ic">{%- render 'vivid-icon', icon: _icon, size: 22 -%}</span>{%- endif -%}
                        <span class="m-mega__link-label">{{ childlink.title | escape }}</span>
                      </a>
                      {%- if childlink.links != blank -%}
                        <ul class="m-mega__sublist" role="list">
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a
                                href="{{ grandchildlink.url }}"
                                class="m-mega__sublink{% if grandchildlink.current %} is-current{% endif %}"
                                {% if grandchildlink.current %}aria-current="page"{% endif %}
                              >{{ grandchildlink.title | escape }}</a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
                {%- if _feat != blank -%}
                  <a class="m-mega__feature" href="{{ _feat.settings.button_url | default: '#' }}" {{ _feat.shopify_attributes }}>
                    {%- if _feat.settings.image != blank -%}
                      <img class="m-mega__feature-img" src="{{ _feat.settings.image | image_url: width: 600 }}" alt="{{ _feat.settings.heading | default: _feat.settings.image.alt | escape }}" loading="lazy" width="{{ _feat.settings.image.width }}" height="{{ _feat.settings.image.height }}">
                    {%- endif -%}
                    <span class="m-mega__feature-body">
                      {%- if _feat.settings.eyebrow != blank -%}<span class="m-mega__feature-eyebrow">{{ _feat.settings.eyebrow | escape }}</span>{%- endif -%}
                      {%- if _feat.settings.heading != blank -%}<span class="m-mega__feature-heading">{{ _feat.settings.heading | escape }}</span>{%- endif -%}
                      {%- if _feat.settings.subtext != blank -%}<span class="m-mega__feature-sub">{{ _feat.settings.subtext | escape }}</span>{%- endif -%}
                      {%- if _feat.settings.button_label != blank -%}<span class="m-mega__feature-cta">{{ _feat.settings.button_label | escape }} &rarr;</span>{%- endif -%}
                    </span>
                  </a>
                {%- endif -%}
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>

{%- comment -%}
  Brands directory — grouped brand grid (Lighting / Controls / Electrical
  Accessories), matching the categorised "Brands We Work With" layout on
  the sister site, vividlightworx.co.uk. "category" blocks open a new
  labelled row; "brand" blocks render as cards inside the current row.
{%- endcomment -%}

<div class="brdir color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="wrap sec">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="t-h1 brdir__h">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="brdir__intro">{{ section.settings.intro }}</div>
    {%- endif -%}

    {%- assign brdir_open = false -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'category' -%}
          {%- if brdir_open -%}</div>{%- endif -%}
          <h2 class="brdir__cat" {{ block.shopify_attributes }}>{{ block.settings.name }}</h2>
          <div class="brdir__grid">
          {%- assign brdir_open = true -%}
        {%- when 'brand' -%}
          <div class="brdir__card" {{ block.shopify_attributes }}>
            <div class="brdir__card-top">
              <span class="brdir__name">{{ block.settings.name }}</span>
              {%- if block.settings.badge != blank -%}<span class="brdir__badge">{{ block.settings.badge }}</span>{%- endif -%}
            </div>
            {%- if block.settings.text != blank -%}<p class="brdir__text">{{ block.settings.text }}</p>{%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
    {%- if brdir_open -%}</div>{%- endif -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% style %}
  .brdir__h { margin: 6px 0 12px; }
  .brdir__intro { max-width: 62ch; color: rgba(var(--color-foreground), 0.72); margin-bottom: 8px; }
  .brdir__cat {
    font-family: var(--font-body-family);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-button));
    margin: 44px 0 16px;
    padding-top: 24px;
    border-top: 1px solid rgba(var(--color-foreground), 0.14);
  }
  .brdir__grid:first-of-type .brdir__cat { border-top: none; padding-top: 0; }
  .brdir__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  @media screen and (max-width: 989px) {
    .brdir__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (max-width: 599px) {
    .brdir__grid { grid-template-columns: 1fr; }
  }
  .brdir__card {
    border: 1px solid rgba(var(--color-foreground), 0.14);
    border-radius: 6px;
    padding: 16px 18px;
    background: rgba(var(--color-foreground), 0.03);
  }
  .brdir__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }
  .brdir__name { font-weight: 700; font-size: 15px; }
  .brdir__badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(var(--color-background));
    background: rgb(var(--color-button));
    padding: 3px 7px;
    border-radius: 3px;
    white-space: nowrap;
  }
  .brdir__text {
    font-size: 13.5px;
    line-height: 1.5;
    color: rgba(var(--color-foreground), 0.68);
    margin: 0;
  }
{% endstyle %}

{% schema %}
{
  "name": "Brands directory",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Library" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Brands We Work With" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>We select only the most exceptional lighting and smart control brands.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "t:sections.all.padding.padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.all.padding.padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 52 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category label",
      "settings": [
        { "type": "text", "id": "name", "label": "Category name", "default": "Lighting" }
      ]
    },
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name", "default": "Brand name" },
        { "type": "text", "id": "text", "label": "Description" },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "info": "e.g. Exclusive" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brands directory",
      "blocks": [
        { "type": "category" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}

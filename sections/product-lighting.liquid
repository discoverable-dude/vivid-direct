{{ 'vivid-sections.css' | asset_url | stylesheet_tag }}
{{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vivid-lightbox.js' | asset_url }}" defer="defer"></script>
{%- comment -%}
  product-lighting.liquid
  Main product page.

  Per-product metafields (set in Shopify admin → product → metafields):
    custom.origin_headline  — headline for the About section
    custom.origin_copy      — multi-line body paragraphs for About section
    (variant) custom.note   — note per variant, e.g. "IP65 rated"

  Section blocks (configure per product in Online Store customizer):
    stat              → spec pills in the info panel (IP65 Rated, Dimmable, etc.)
    related_product   → "Pairs well with" product cards
    faq               → "Care & keeping" accordion items
{%- endcomment -%}

{%- assign pp_variant = product.selected_or_first_available_variant -%}
{%- assign pp_form_id = 'pp-form-' | append: section.id -%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<div class="pp-root pp-root--dark">

<!-- ═══════════════════════════════════════════════
     HERO — gallery + info
     ═══════════════════════════════════════════════ -->
<div class="pp-hero color-{{ section.settings.hero_scheme }} gradient" style="--paper: rgb(var(--color-background)); --paper-2: rgb(var(--color-background)); --bark: rgb(var(--color-background)); --ink: rgb(var(--color-foreground)); --ink-soft: rgba(var(--color-foreground), 0.68);">
  <div class="wrap">

    <div class="pp-hero__grid">

      <!-- Gallery -->
      <div class="pp-gallery">
        <div class="pp-gallery__main">
          <img id="pp-main-img-{{ section.id }}"
               src="{{ product.featured_image | image_url: width: 1400 }}"
               alt="{{ product.featured_image.alt | default: product.title | escape }}"
               loading="eager"
               fetchpriority="high"
               width="{{ product.featured_image.width }}"
               height="{{ product.featured_image.height }}"
               data-zoomable>
        </div>

        {%- if product.images.size > 1 -%}
          <div class="pp-gallery__thumbs">
            {%- for img in product.images limit: 5 -%}
              <button class="pp-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                      data-src="{{ img | image_url: width: 1400 }}"
                      data-alt="{{ img.alt | default: product.title | escape }}"
                      type="button"
                      aria-label="Product image {{ forloop.index }}">
                <img src="{{ img | image_url: width: 280 }}"
                     alt="{{ img.alt | default: product.title | escape }}"
                     width="280"
                     height="{{ 280 | divided_by: img.aspect_ratio | default: 280 | round }}"
                     loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Info panel -->
      <div class="pp-info">

        {%- comment -%} Breadcrumb — inside info panel, right-column position matches design {%- endcomment -%}
        {%- assign crumb_coll = collection -%}
        {%- if crumb_coll == blank and product.collections.size > 0 -%}
          {%- assign crumb_coll = product.collections.first -%}
        {%- endif -%}
        <nav class="pp-crumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span aria-hidden="true">›</span>
          {%- if crumb_coll != blank -%}
            <a href="{{ crumb_coll.url }}">{{ crumb_coll.title }}</a>
            <span aria-hidden="true">›</span>
          {%- endif -%}
          <span>{{ product.title }}</span>
        </nav>

        <h1 class="pp-title">{{ product.title }}</h1>

        {%- assign pp_stats = section.blocks | where: "type", "stat" -%}
        {%- if pp_stats.size > 0 -%}
          <ul class="pp-stats">
            {%- for block in pp_stats -%}
              {%- if block.settings.label != blank -%}
                <li class="pp-stat" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != "none" -%}
                    <span class="pp-stat__icon">{%- render 'vivid-icon', icon: block.settings.icon, size: 15 -%}</span>
                  {%- endif -%}
                  <span>{{ block.settings.label }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="pp-price" id="pp-price-{{ section.id }}">
          {%- if product.price_varies -%}
            {{ product.price_min | money }} – {{ product.price_max | money }}
          {%- else -%}
            {{ product.price | money }}
          {%- endif -%}
        </div>

        {%- if product.description != blank -%}
          <div class="pp-desc">{{ product.description }}</div>
        {%- endif -%}

        {%- comment -%} Buy box — variants + ATC + delivery {%- endcomment -%}
        <div class="pp-buy-box">

          {%- comment -%}
            Variant selectors — same <variant-selects> component and
            product-variant-picker/product-variant-options snippets as
            Dawn's default product template (dropdown or pill per option,
            sold-out combinations greyed out). The picker itself only
            toggles selection; matching the choice to a real variant and
            updating price/ATC state is done by the plain client-side
            script at the bottom of this file rather than Dawn's
            section-rendering-API round trip, since this template's buy box
            (gallery, qty stepper, trust row) isn't structured the way
            Dawn's <product-info> expects.
          {%- endcomment -%}
          {%- assign pp_variant_picker_block = section.blocks | where: "type", "variant_picker" | first -%}
          {%- if pp_variant_picker_block -%}
            {%- render 'product-variant-picker', product: product, block: pp_variant_picker_block, product_form_id: pp_form_id -%}
          {%- endif -%}

          {%- comment -%} ATC form — wrapped in <product-form> so add-to-cart is AJAX and opens the drawer {%- endcomment -%}
          <product-form class="product-form pp-product-form" data-hide-errors="false" data-section-id="{{ section.id }}">
            <div class="product-form__error-message-wrapper pp-atc-error" role="alert" hidden>
              <span class="product-form__error-message"></span>
            </div>

            <form action="{{ routes.cart_add_url }}" method="post" id="pp-form-{{ section.id }}">
              <input type="hidden" name="id" id="pp-vid-{{ section.id }}" value="{{ pp_variant.id }}">
              {%- if pp_variant_picker_block -%}
                <script type="application/json" id="pp-variants-{{ section.id }}">{{ product.variants | json }}</script>
              {%- endif -%}

              <div class="pp-atc-row">
                <div class="pp-qty" aria-label="Quantity">
                  <button type="button" class="pp-qty__btn pp-qty__btn--minus" aria-label="Decrease">−</button>
                  <input class="pp-qty__n" type="number" name="quantity" id="pp-qty-{{ section.id }}"
                         value="1" min="1" aria-label="Quantity">
                  <button type="button" class="pp-qty__btn pp-qty__btn--plus" aria-label="Increase">+</button>
                </div>

                <button type="submit"
                        name="add"
                        class="pp-atc{% unless pp_variant.available %} pp-atc--sold{% endunless %}"
                        id="pp-atc-{{ section.id }}"
                        {% unless pp_variant.available %}disabled{% endunless %}>
                  <span>
                    {%- if pp_variant.available -%}
                      Add to Basket · <span class="pp-atc__price">{{ pp_variant.price | money }}</span>
                    {%- else -%}
                      Sold Out
                    {%- endif -%}
                  </span>
                  {%- render 'loading-spinner' -%}
                </button>
              </div>
            </form>
          </product-form>

          <p class="pp-delivery">
            {%- render 'vivid-icon', icon: 'truck', size: 16 -%}
            {{ section.settings.delivery_note }}
          </p>

          {%- liquid
            # Per-product override: custom.trust_1/2/3 metafields beat the
            # template-wide settings; a value of "-" hides that line.
            assign _t1 = product.metafields.custom.trust_1.value | default: section.settings.trust_1
            assign _t2 = product.metafields.custom.trust_2.value | default: section.settings.trust_2
            assign _t3 = product.metafields.custom.trust_3.value | default: section.settings.trust_3
            if _t1 == '-'
              assign _t1 = ''
            endif
            if _t2 == '-'
              assign _t2 = ''
            endif
            if _t3 == '-'
              assign _t3 = ''
            endif
          -%}
          {%- render 'product-trust', t1: _t1, t2: _t2, t3: _t3 -%}

        </div>

      </div>
    </div>
  </div>
</div>


<!-- ═══════════════════════════════════════════════
     ABOUT — farm image + origin story
     ═══════════════════════════════════════════════ -->
{%- assign pp_headline = product.metafields.custom.origin_headline -%}
{%- assign pp_copy = product.metafields.custom.origin_copy -%}
{%- assign pp_faqs = section.blocks | where: "type", "faq" -%}
{%- if pp_headline != blank or pp_copy != blank or pp_faqs.size > 0 -%}
<div class="pp-about color-{{ section.settings.about_scheme }} gradient" style="--bark: rgb(var(--color-background)); --white: rgb(var(--color-foreground));">
  {%- if section.settings.about_image != blank -%}
    <img class="pp-about__bg"
         src="{{ section.settings.about_image | image_url: width: 2400 }}"
         alt=""
         width="2400"
         height="{{ 2400 | divided_by: section.settings.about_image.aspect_ratio | default: 2400 | round }}"
         loading="lazy"
         aria-hidden="true"
         style="opacity: {{ section.settings.about_image_opacity | divided_by: 100.0 }}">
  {%- endif -%}
  <div class="pp-about__overlay"></div>
  <div class="wrap pp-about__inner">
    <div class="pp-about__left">
      <p class="pp-about__eyebrow">About this product</p>
      {%- if pp_headline != blank -%}
        <h2 class="pp-about__headline">{{ pp_headline }}</h2>
      {%- endif -%}
    </div>
    {%- if pp_faqs.size > 0 -%}
      {%- comment -%}
        Care & keeping accordion lives here on the image band (faq blocks),
        replacing the origin_copy text that duplicated the old standalone
        accordion section.
      {%- endcomment -%}
      <div class="pp-about__acc">
        {%- for block in pp_faqs -%}
          <details class="pp-acc__item" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="pp-acc__q">
              <span>{{ block.settings.title }}</span>
              {%- render 'vivid-icon', icon: 'chevron', size: 18 -%}
            </summary>
            <div class="pp-acc__a">{{ block.settings.body }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- elsif pp_copy != blank -%}
      <div class="pp-about__copy">{{ pp_copy | newline_to_br }}</div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}


<!-- ═══════════════════════════════════════════════
     DESIGN ARTICLES — section blocks
     ═══════════════════════════════════════════════ -->
{%- comment -%}
  "Design articles that feature this product" — reverse-lookup the design blog for articles
  whose design_featured_product or design_shop_items reference this product. Link once on
  the article (its shop items / featured product) and it appears here automatically. Max 3.
  Renamed from the Vivid theme's "Recipes that use this product" block.
{%- endcomment -%}
{%- capture pp_design_cards -%}
  {%- assign _rc = 0 -%}
  {%- for art in blogs.design.articles -%}
    {%- if _rc >= 3 -%}{%- break -%}{%- endif -%}
    {%- assign _match = false -%}
    {%- assign _feat = art.metafields.custom.design_featured_product.value -%}
    {%- if _feat and _feat.id == product.id -%}{%- assign _match = true -%}{%- endif -%}
    {%- unless _match -%}
      {%- for _v in art.metafields.custom.design_shop_items.value -%}
        {%- if _v.product.id == product.id -%}{%- assign _match = true -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
    {%- endunless -%}
    {%- if _match -%}
      {%- assign _rc = _rc | plus: 1 -%}
      {%- assign _sub = art.metafields.descriptors.subtitle.value -%}
      <a href="{{ art.url }}" class="pp-recipe-card">
        <div class="pp-recipe-card__img">
          {%- if art.image != blank -%}
            <img src="{{ art.image | image_url: width: 700 }}" alt="{{ art.title | escape }}" width="700" height="{{ 700 | divided_by: art.image.aspect_ratio | default: 700 | round }}" loading="lazy">
          {%- else -%}
            <div class="pp-recipe-card__placeholder">
              {%- render 'vivid-icon', icon: 'lightbulb', size: 36 -%}
              <span>Article photo coming soon</span>
            </div>
          {%- endif -%}
        </div>
        <p class="pp-recipe-card__name">{{ art.title }}</p>
        {%- if _sub != blank -%}<p class="pp-recipe-card__sub">{{ _sub }}</p>{%- endif -%}
      </a>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if pp_design_cards != blank -%}
<div class="pp-recipes color-{{ section.settings.recipes_scheme }} gradient" style="--paper: rgb(var(--color-background)); --ink: rgb(var(--color-foreground)); --ink-soft: rgba(var(--color-foreground), 0.68);">
  <div class="wrap">
    <div class="pp-recipes__head">
      <div>
        <p class="pp-eyebrow">See it installed</p>
        <h2 class="pp-recipes__heading">Design articles featuring {{ product.title }}</h2>
      </div>
      {%- if section.settings.design_articles_url != blank -%}
        <a href="{{ section.settings.design_articles_url }}" class="pp-viewall">
          All design articles
          {%- render 'vivid-icon', icon: 'chevron', size: 18 -%}
        </a>
      {%- endif -%}
    </div>
    <div class="pp-recipes__grid">{{ pp_design_cards }}</div>
  </div>
</div>
{%- endif -%}


<!-- ═══════════════════════════════════════════════
     PAIRS WELL WITH — section blocks
     ═══════════════════════════════════════════════ -->
{%- assign pp_related = section.blocks | where: "type", "related_product" -%}
{%- if pp_related.size > 0 -%}
<div class="pp-related color-{{ section.settings.related_scheme }} gradient" style="--paper-2: rgb(var(--color-background)); --ink: rgb(var(--color-foreground)); --ink-soft: rgba(var(--color-foreground), 0.68);">
  <div class="wrap">
    <p class="pp-eyebrow">You may also like</p>
    <h2 class="pp-related__heading">Pairs well with</h2>
    <div class="pp-related__grid">
      {%- for block in pp_related -%}
        {%- assign rp = block.settings.product -%}
        {%- if rp != blank -%}
          <div {{ block.shopify_attributes }}>{%- render 'product-card', product: rp -%}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}


<script>
(function () {
  var sid = '{{ section.id }}';

  /* ── Gallery ── */
  var mainImg = document.getElementById('pp-main-img-' + sid);
  document.querySelectorAll('.pp-gallery__thumb').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.pp-gallery__thumb').forEach(function (b) { b.classList.remove('is-active'); });
      btn.classList.add('is-active');
      if (mainImg) { mainImg.src = btn.dataset.src; mainImg.alt = btn.dataset.alt || ''; }
    });
  });

  /* ── Variant picker ──
     <variant-selects> (Dawn's own component, defined in global.js) tracks
     selection and disables sold-out option values on its own; we only need
     to react to its native 'change' event, work out which real variant that
     combination maps to, and update price/ATC state to match — no
     section-rendering-API round trip. */
  var vidInput   = document.getElementById('pp-vid-' + sid);
  var atcBtn     = document.getElementById('pp-atc-' + sid);
  var priceLine  = document.getElementById('pp-price-' + sid);
  var variantsEl = document.getElementById('pp-variants-' + sid);
  var picker     = document.getElementById('variant-selects-' + sid);

  if (variantsEl && picker) {
    var variants = JSON.parse(variantsEl.textContent);

    var moneyFormat = function (cents) {
      return (cents / 100).toLocaleString('en-GB', { style: 'currency', currency: '{{ cart.currency.iso_code | default: shop.currency }}' });
    };

    var currentSelection = function () {
      var values = [];
      picker.querySelectorAll('fieldset, .product-form__input--dropdown').forEach(function (group) {
        var checked = group.querySelector('input:checked');
        var select  = group.querySelector('select');
        if (checked) values.push(checked.value);
        else if (select) values.push(select.value);
      });
      return values;
    };

    var findVariant = function (values) {
      return variants.filter(function (v) {
        return v.options.length === values.length && v.options.every(function (opt, i) { return opt === values[i]; });
      })[0];
    };

    var applyVariant = function (variant) {
      if (!variant) {
        if (atcBtn) { atcBtn.disabled = true; atcBtn.classList.add('pp-atc--sold'); atcBtn.querySelector('span').textContent = 'Unavailable'; }
        return;
      }
      if (vidInput) vidInput.value = variant.id;
      var priceStr = moneyFormat(variant.price);
      if (priceLine) priceLine.textContent = priceStr;
      if (atcBtn) {
        var priceEl = atcBtn.querySelector('.pp-atc__price');
        var labelEl = atcBtn.querySelector('span');
        atcBtn.disabled = !variant.available;
        atcBtn.classList.toggle('pp-atc--sold', !variant.available);
        if (!variant.available) {
          labelEl.textContent = 'Sold Out';
        } else if (priceEl) {
          priceEl.textContent = priceStr;
        } else {
          labelEl.innerHTML = 'Add to Basket · <span class="pp-atc__price">' + priceStr + '</span>';
        }
      }
    };

    picker.addEventListener('change', function () {
      applyVariant(findVariant(currentSelection()));
    });
  }

  /* ── Quantity stepper ── */
  var qtyInput = document.getElementById('pp-qty-' + sid);
  if (qtyInput) {
    document.querySelectorAll('#pp-form-' + sid + ' .pp-qty__btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var v = parseInt(qtyInput.value, 10) || 1;
        qtyInput.value = btn.classList.contains('pp-qty__btn--minus') ? Math.max(1, v - 1) : v + 1;
      });
    });
    qtyInput.addEventListener('change', function () {
      qtyInput.value = Math.max(1, parseInt(qtyInput.value, 10) || 1);
    });
  }
}());
</script>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

</div><!-- /.pp-root -->

{%- style -%}
  .pp-root--dark {
    --paper: #082A38;
    --card: #0D4761;
    --ink: #F6F0EA;
    --ink-soft: rgba(246, 240, 234, 0.68);
    --line: rgba(255, 255, 255, 0.14);
    --line-strong: rgba(255, 255, 255, 0.26);
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Product page",
  "tag": "div",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "header", "content": "Section colours" },
    { "type": "color_scheme", "id": "hero_scheme", "label": "Hero colour scheme", "default": "scheme-1" },
    { "type": "color_scheme", "id": "about_scheme", "label": "About colour scheme", "default": "scheme-4" },
    { "type": "color_scheme", "id": "recipes_scheme", "label": "Design articles colour scheme", "default": "scheme-1" },
    { "type": "color_scheme", "id": "related_scheme", "label": "Pairs well with colour scheme", "default": "scheme-1" },
    { "type": "header", "content": "Buy-box trust row" },
    { "type": "text", "id": "trust_1", "label": "Trust point 1", "default": "Trade pricing available" },
    { "type": "text", "id": "trust_2", "label": "Trust point 2", "default": "Free next day delivery over £150" },
    { "type": "text", "id": "trust_3", "label": "Trust point 3", "default": "Packed & shipped within 1 working day" },
    {
      "type": "image_picker",
      "id": "about_image",
      "label": "About section background image",
      "info": "Set once; applies to all products using this template."
    },
    {
      "type": "range",
      "id": "about_image_opacity",
      "label": "Image opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "text",
      "id": "delivery_note",
      "label": "Delivery note",
      "default": "Free next day delivery over £150 · order by 1pm"
    },
    {
      "type": "url",
      "id": "design_articles_url",
      "label": "Design articles link URL"
    }
  ],
  "blocks": [
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "Picker type",
          "default": "button",
          "options": [
            { "value": "button", "label": "Pills" },
            { "value": "dropdown", "label": "Dropdowns" }
          ]
        },
        {
          "type": "select",
          "id": "swatch_shape",
          "label": "Swatch shape",
          "info": "Only used for options with a colour/image swatch set on the value.",
          "default": "none",
          "options": [
            { "value": "circle", "label": "Circle" },
            { "value": "square", "label": "Square" },
            { "value": "none", "label": "No swatch — text only" }
          ]
        }
      ]
    },
    {
      "type": "stat",
      "name": "Stat pill",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "info": "e.g. IP65 Rated, 24V, 3000K", "default": "IP65 Rated" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "check", "options": [
          { "value": "none", "label": "No icon" },
          { "value": "check", "label": "Check" },
          { "value": "lightbulb", "label": "Lightbulb" },
          { "value": "eye", "label": "Eye" },
          { "value": "house", "label": "House" },
          { "value": "building", "label": "Building" },
          { "value": "truck", "label": "Delivery truck" },
          { "value": "clock", "label": "Clock" },
          { "value": "package", "label": "Package" }
        ] }
      ]
    },
    {
      "type": "related_product",
      "name": "Paired product",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    },
    {
      "type": "faq",
      "name": "Care & keeping item",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Care & keeping" },
        { "type": "richtext", "id": "body", "label": "Body" },
        { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  Vivid Custom Form — configurable contact form.
  Fields are blocks (text / email / phone / textarea / select / checkbox / file).
  Submissions email the store's contact address via Shopify's {% form 'contact' %}.
  An "email" field becomes the reply-to; every other field is included in the
  message body.

  Optional multi-step mode: turn on "Split into multiple steps" and tick
  "Start a new step before this field" on any field block to break it there.
  Steps are a front-end-only wizard — the form still posts as a single
  submission when the last step's button is pressed.
{%- endcomment -%}

{{ 'vivid-page.css' | asset_url | stylesheet_tag }}
{%- if section.settings.multi_step -%}
  <script src="{{ 'vivid-form-steps.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- capture form_style -%}
  --paper: rgb(var(--color-background)); --paper-2: rgb(var(--color-background)); --ink: rgb(var(--color-foreground)); --ink-soft: rgba(var(--color-foreground), 0.68); --line: rgba(var(--color-foreground), 0.14); --line-strong: rgba(var(--color-foreground), 0.28);
  {%- if section.settings.button_bg != blank -%}--btn-bg: {{ section.settings.button_bg }}; --btn-bg-hover: {{ section.settings.button_bg | color_darken: 12 }};{%- endif -%}
  {%- if section.settings.button_text != blank -%}--btn-text: {{ section.settings.button_text }};{%- endif -%}
{%- endcapture -%}

<section class="m-sec m-form color-{{ section.settings.color_scheme }} gradient" style="{{ form_style }}">
  <div class="m-sec__wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="m-form__head{% if section.settings.content_align == 'center' %} m-form__head--center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}<p class="m-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="m-heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.intro != blank -%}<div class="m-intro">{{ section.settings.intro }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- form 'contact', class: 'm-form__form', enctype: 'multipart/form-data' -%}
      {%- if section.settings.multi_step -%}<input type="hidden" data-form-multi-step value="1">{%- endif -%}
      {%- if form.posted_successfully? -%}
        <p class="m-form__note m-form__note--success">{{ section.settings.success_message }}</p>
      {%- elsif form.errors -%}
        <p class="m-form__note m-form__note--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      {%- assign current_step = 1 -%}
      <div class="m-form__grid m-form__step is-active" data-step="1">
      {%- for block in section.blocks -%}
        {%- unless forloop.first -%}
          {%- if section.settings.multi_step and block.settings.new_step -%}
            </div>
            {%- assign current_step = current_step | plus: 1 -%}
            <div class="m-form__grid m-form__step" data-step="{{ current_step }}">
          {%- endif -%}
        {%- endunless -%}
        {%- liquid
          assign f_label = block.settings.label
          assign f_name = 'contact[' | append: f_label | append: ']'
          if block.settings.type == 'email'
            assign f_name = 'contact[email]'
          endif
          assign f_id = 'MForm-' | append: section.id | append: '-' | append: forloop.index
        -%}
        {%- if block.settings.type == 'checkbox' -%}
          <div class="m-form__field m-form__field--full m-form__field--checkbox" {{ block.shopify_attributes }}>
            <label class="m-form__checkbox-label">
              <input
                type="checkbox"
                name="{{ f_name }}"
                value="Yes"
                {% if block.settings.required %}required{% endif %}
              >
              <span>{{ f_label }}{% if block.settings.required %}<span class="m-req"> *</span>{% endif %}</span>
            </label>
          </div>
        {%- else -%}
          <div class="m-form__field{% if block.settings.type == 'textarea' or block.settings.width == 'full' %} m-form__field--full{% endif %}" {{ block.shopify_attributes }}>
            <label class="m-form__label" for="{{ f_id }}">
              {{ f_label }}{% if block.settings.required %}<span class="m-req"> *</span>{% endif %}
            </label>
            {%- case block.settings.type -%}
              {%- when 'textarea' -%}
                <textarea
                  id="{{ f_id }}"
                  class="m-form__textarea"
                  name="{{ f_name }}"
                  placeholder="{{ block.settings.placeholder }}"
                  {% if block.settings.required %}required{% endif %}
                ></textarea>
              {%- when 'select' -%}
                <select id="{{ f_id }}" class="m-form__input m-form__select" name="{{ f_name }}" {% if block.settings.required %}required{% endif %}>
                  {%- if block.settings.placeholder != blank -%}<option value="" disabled selected>{{ block.settings.placeholder }}</option>{%- endif -%}
                  {%- assign f_options = block.settings.options | split: "," -%}
                  {%- for opt in f_options -%}
                    {%- assign opt_trimmed = opt | strip -%}
                    <option value="{{ opt_trimmed }}">{{ opt_trimmed }}</option>
                  {%- endfor -%}
                </select>
              {%- when 'file' -%}
                <input
                  id="{{ f_id }}"
                  class="m-form__input m-form__file"
                  type="file"
                  name="{{ f_name }}[]"
                  accept=".pdf,.jpg,.jpeg,.png"
                  {% if block.settings.required %}required{% endif %}
                >
              {%- else -%}
                <input
                  id="{{ f_id }}"
                  class="m-form__input"
                  type="{{ block.settings.type }}"
                  name="{{ f_name }}"
                  placeholder="{{ block.settings.placeholder }}"
                  {% if block.settings.type == 'email' %}autocomplete="email"{% endif %}
                  {% if block.settings.required %}required{% endif %}
                >
            {%- endcase -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
      </div>

      {%- if section.settings.multi_step -%}
        <div class="m-form__stepnav" data-form-stepnav data-total-steps="{{ current_step }}">
          <div class="m-form__stepdots" aria-hidden="true">
            {%- for i in (1..current_step) -%}
              <span class="m-form__stepdot{% if forloop.first %} is-active{% endif %}" data-dot="{{ i }}"></span>
            {%- endfor -%}
          </div>
          <div class="m-form__stepbtns">
            <button type="button" class="m-btn m-form__back" data-form-back hidden>Back</button>
            <button type="button" class="m-btn m-btn--primary m-form__next" data-form-next>Next</button>
            <button type="submit" class="m-btn m-btn--primary m-form__submit" data-form-submit hidden>{{ section.settings.submit_label }}</button>
          </div>
        </div>
      {%- else -%}
        <button type="submit" class="m-btn m-btn--primary m-form__submit">{{ section.settings.submit_label }}</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom form",
  "tag": "section",
  "class": "m-section",
  "settings": [
    { "type": "header", "content": "Colour" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "color", "id": "button_bg", "label": "Button background", "info": "Optional. Leave blank to use the theme's default button colour." },
    { "type": "color", "id": "button_text", "label": "Button text colour", "info": "Optional." },
    { "type": "header", "content": "Header (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Fill in the form below and we'll get back to you within one working day.</p>" },
    { "type": "select", "id": "content_align", "label": "Header alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "left" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Send enquiry" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks — we've got your message and will be in touch shortly." },
    { "type": "checkbox", "id": "multi_step", "label": "Split into multiple steps (wizard)", "default": false, "info": "Use the \"Start a new step before this field\" toggle on a field block to choose where each step begins." }
  ],
  "blocks": [
    {
      "type": "field",
      "name": "Field",
      "settings": [
        { "type": "select", "id": "type", "label": "Field type", "options": [ { "value": "text", "label": "Text" }, { "value": "email", "label": "Email (reply-to)" }, { "value": "tel", "label": "Phone" }, { "value": "textarea", "label": "Message (multi-line)" }, { "value": "select", "label": "Dropdown" }, { "value": "checkbox", "label": "Checkbox (single, e.g. terms agreement)" }, { "value": "file", "label": "File upload" } ], "default": "text" },
        { "type": "text", "id": "label", "label": "Label", "default": "Field label", "info": "For a checkbox, this is the text shown next to it." },
        { "type": "text", "id": "placeholder", "label": "Placeholder", "info": "For a dropdown, this is used as the first, unselectable option." },
        { "type": "text", "id": "options", "label": "Dropdown options", "info": "Dropdown fields only. Comma-separated, e.g. Standard, Trade, VIP." },
        { "type": "checkbox", "id": "required", "label": "Required", "default": false },
        { "type": "select", "id": "width", "label": "Width", "options": [ { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" } ], "default": "half", "info": "Message fields are always full width." },
        { "type": "checkbox", "id": "new_step", "label": "Start a new step before this field", "default": false, "info": "Only used when \"Split into multiple steps\" is turned on above." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom form",
      "blocks": [
        { "type": "field", "settings": { "type": "text", "label": "Your name", "placeholder": "Jane Smith", "required": true, "width": "half" } },
        { "type": "field", "settings": { "type": "text", "label": "Business name", "placeholder": "The Crown, Tenterden", "width": "half" } },
        { "type": "field", "settings": { "type": "email", "label": "Email address", "placeholder": "jane@example.com", "required": true, "width": "half" } },
        { "type": "field", "settings": { "type": "tel", "label": "Phone (optional)", "placeholder": "+44 7700 000000", "width": "half" } },
        { "type": "field", "settings": { "type": "textarea", "label": "Tell us what you need", "placeholder": "Products you're interested in, quantities, delivery area…", "required": true } }
      ]
    }
  ]
}
{% endschema %}

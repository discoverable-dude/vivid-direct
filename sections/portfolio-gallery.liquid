{%- comment -%}
  Portfolio Gallery — showcases lighting installation projects. Images are
  theme assets (not Shopify-hosted), referenced via asset_url, since they
  come from the sister company's project archive rather than product photos.
{%- endcomment -%}

<section class="port-gal" id="port-gal-{{ section.id }}">
  <div class="wrap sec">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="t-h1 port-gal__h">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="port-gal__intro">{{ section.settings.intro }}</div>
    {%- endif -%}

    <div class="port-gal__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == "project" -%}
          <div class="port-gal__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image_filename != blank -%}
              <img
                src="{{ block.settings.image_filename | asset_url }}"
                alt="{{ block.settings.name | escape }}"
                width="{{ block.settings.image_width }}"
                height="{{ block.settings.image_height }}"
                loading="lazy">
            {%- endif -%}
            <div class="port-gal__item-info">
              {%- if block.settings.name != blank -%}<h3 class="port-gal__item-name">{{ block.settings.name }}</h3>{%- endif -%}
              {%- if block.settings.note != blank -%}<p class="port-gal__item-note">{{ block.settings.note }}</p>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.attribution != blank -%}
      <p class="port-gal__attribution">{{ section.settings.attribution }}</p>
    {%- endif -%}
  </div>
</section>

{% style %}
  .port-gal__h { color: var(--ink); margin: 12px 0 20px; }
  .port-gal__intro {
    max-width: 68ch;
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 40px;
  }
  .port-gal__intro a { color: var(--field); text-decoration: underline; text-underline-offset: 2px; }

  .port-gal__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 28px;
  }
  .port-gal__item {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--paper-2);
    box-shadow: var(--shadow-card);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .port-gal__item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }
  .port-gal__item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .port-gal__item-info { padding: 16px 18px 20px; }
  .port-gal__item-name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 17px;
    color: var(--ink);
    margin: 0 0 4px;
  }
  .port-gal__item-note {
    font-size: 13.5px;
    color: var(--ink-soft);
    margin: 0;
  }

  .port-gal__attribution {
    margin-top: 44px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--ink-soft);
  }
  .port-gal__attribution a { color: var(--field); text-decoration: underline; text-underline-offset: 2px; font-weight: 600; }
{% endstyle %}

{% schema %}
{
  "name": "Portfolio gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our work" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lighting installations" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Vivid Direct supplies the products — our sister company, <a href=\"https://vividlightworx.co.uk\">Vivid LightWorX</a>, brings them to life. Here's a look at some of their recent lighting design and installation projects.</p>"
    },
    {
      "type": "richtext",
      "id": "attribution",
      "label": "Attribution note",
      "default": "<p>Projects designed and installed by <a href=\"https://vividlightworx.co.uk\">Vivid LightWorX</a>, our sister company. Interested in a bespoke lighting design and installation service? <a href=\"https://vividlightworx.co.uk\">Get in touch with the LightWorX team</a>.</p>"
    }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "Project",
      "settings": [
        { "type": "text", "id": "image_filename", "label": "Image filename (theme asset)", "info": "The exact filename as it exists in the theme's assets folder, e.g. portfolio-mayfair-1.jpg" },
        { "type": "text", "id": "image_width", "label": "Image width (px)", "info": "The image's actual pixel width, for layout stability" },
        { "type": "text", "id": "image_height", "label": "Image height (px)", "info": "The image's actual pixel height, for layout stability" },
        { "type": "text", "id": "name", "label": "Project name" },
        { "type": "text", "id": "note", "label": "Short note (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portfolio gallery",
      "blocks": [
        { "type": "project" },
        { "type": "project" },
        { "type": "project" }
      ]
    }
  ]
}
{% endschema %}

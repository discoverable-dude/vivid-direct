{{ 'morghew-sections.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  morghew-product-grid.liquid
  Branded product grid — replaces Dawn's featured-collection on Morghew templates.
  Renders up to 4 products from a chosen collection using the unified card-potato snippet.
  Excludes the current product when rendered on a product page.
{%- endcomment -%}

{%- assign grid_coll = collections[section.settings.collection] -%}
{%- assign limit = section.settings.products_to_show | default: 4 -%}
{%- assign shown = 0 -%}

{%- comment -%} Bail silently if collection is empty or unset {%- endcomment -%}
{%- if grid_coll == blank or grid_coll.products_count == 0 -%}
  {%- if request.design_mode -%}
    <div class="mpg-placeholder">
      <div class="wrap"><p>Select a collection in section settings.</p></div>
    </div>
  {%- endif -%}
{%- else -%}

<div class="mpg" data-bg="{{ section.settings.background }}">
  <div class="wrap">

    {%- if section.settings.eyebrow != blank -%}
      <p class="pp-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="mpg__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="mpg__grid">
      {%- for p in grid_coll.products -%}
        {%- if product and p.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- if shown >= limit -%}{%- break -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}

        {%- render 'card-potato', product: p -%}

      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all and grid_coll.url != blank -%}
      <div class="mpg__footer">
        <a href="{{ grid_coll.url }}" class="pp-viewall">
          {{ section.settings.view_all_label | default: "View all" }}
          {%- render 'morghew-icon', icon: 'chevron', size: 18 -%}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{%- endif -%}

{% schema %}
{
  "name": "Morghew product grid",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pairs well with"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": false
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link text",
      "default": "View all"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper (cream)" },
        { "value": "paper-2", "label": "Paper 2 (warm linen)" },
        { "value": "bark", "label": "Bark (dark)" }
      ],
      "default": "paper-2"
    }
  ],
  "presets": [
    {
      "name": "Morghew product grid"
    }
  ]
}
{% endschema %}

{%- comment -%}
  Driver selector for LED strip pages.
  Reads the strip's watts per metre (product metafield custom.watts_per_metre), asks for the length and the driver type, and recommends the right driver from the Foss driver matrix (assets/driver-matrix.js), with an add to basket button.
  Shows nothing on products without watts per metre, so it is safe to add to the product template. Set "Show without a strip" to use it on a page with a watts per metre picker.
{%- endcomment -%}
{{ 'vivid-sections.css' | asset_url | stylesheet_tag }}
{%- assign ds_wpm_raw = product.metafields.custom.watts_per_metre.value | default: '' -%}
{%- assign ds_wpm_list = ds_wpm_raw | replace: ' ', '' | split: ',' -%}
{%- if ds_wpm_list.size == 0 and section.settings.standalone == false -%}
  {%- if request.design_mode -%}<div class="wrap" style="padding:16px 0;opacity:.6;">Driver selector: this product has no watts per metre, so nothing shows here.</div>{%- endif -%}
{%- else -%}
<section class="dsel color-{{ section.settings.color_scheme }} gradient" id="dsel-{{ section.id }}" data-dsel data-wpm-list="{{ ds_wpm_list | join: ',' }}" data-standalone="{{ section.settings.standalone }}" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;">
  <div class="wrap">
    <div class="dsel__card">
      <h2 class="dsel__title">{{ section.settings.heading }}</h2>
      <p class="dsel__intro">{{ section.settings.intro }}</p>
      <div class="dsel__grid">
        <label class="dsel__field" data-dsel-wpm-wrap>
          <span>Strip power</span>
          <select data-dsel-wpm></select>
        </label>
        <label class="dsel__field">
          <span>Length of strip in metres</span>
          <input type="number" min="1" step="1" value="5" inputmode="numeric" data-dsel-length>
        </label>
      </div>
      <div class="dsel__types" role="radiogroup" aria-label="Driver type" data-dsel-types></div>
      <div class="dsel__result" aria-live="polite" data-dsel-result></div>
      <p class="dsel__note">Prices shown are ex VAT. Always check the driver suits your controls and the strip's voltage (24V). If unsure, call us on 0203 916 6116.</p>
    </div>
  </div>
</section>
<script src="{{ 'driver-matrix.js' | asset_url }}" defer></script>
<script src="{{ 'vivid-card.js' | asset_url }}" defer></script>
<script>
(function () {
  function init() {
    var M = window.VIVID_DRIVER_MATRIX; if (!M) return setTimeout(init, 60);
    document.querySelectorAll('[data-dsel]').forEach(function (root) {
      if (root.__ready) return; root.__ready = true;
      var wpmSel = root.querySelector('[data-dsel-wpm]'), lenIn = root.querySelector('[data-dsel-length]');
      var typesEl = root.querySelector('[data-dsel-types]'), res = root.querySelector('[data-dsel-result]');
      var standalone = root.getAttribute('data-standalone') === 'true';
      var list = (root.getAttribute('data-wpm-list') || '').split(',').map(function (s) { return parseFloat(s); }).filter(function (n) { return n > 0; });
      if (!list.length || standalone) list = list.length ? list : M.blocks.map(function (b) { return b.wpm; });
      list.forEach(function (w) { var o = document.createElement('option'); o.value = w; o.textContent = w + ' W per metre'; wpmSel.appendChild(o); });
      if (list.length === 1 && !standalone) root.querySelector('[data-dsel-wpm-wrap]').style.display = 'none';
      var TYPE_LABEL = { 'Fixed': 'Non-dimmable', 'Dimmable': 'Dimmable', 'DALI Dimmable': 'DALI dimmable', 'Slim Dimmable': 'Slim dimmable', 'Slim DALI Dimmable': 'Slim DALI' };
      var TYPE_HELP = { 'Fixed': 'Constant brightness, lowest price', 'Dimmable': 'Mains dimmable (wall dimmer)', 'DALI Dimmable': 'For DALI control systems', 'Slim Dimmable': 'Slim IP20 body, mains dimmable', 'Slim DALI Dimmable': 'Slim IP20 body, DALI' };
      var type = null, token = 0;
      function blockFor(w) {
        var exact = M.blocks.filter(function (b) { return b.wpm === w; })[0];
        if (exact) return { b: exact, est: false };
        var up = M.blocks.filter(function (b) { return b.wpm > w; }).sort(function (a, b) { return a.wpm - b.wpm; })[0];
        return { b: up || M.blocks[M.blocks.length - 1], est: true };
      }
      function money(c) { return '£' + (c / 100).toFixed(2); }
      function render() {
        var my = ++token;
        var w = parseFloat(wpmSel.value), L = Math.max(1, Math.round(parseFloat(lenIn.value) || 1));
        var bf = blockFor(w), b = bf.b, total = Math.round(w * L * 10) / 10;
        var types = Object.keys(b.cells);
        if (!type || types.indexOf(type) < 0) type = types[0];
        typesEl.innerHTML = '';
        types.forEach(function (t) {
          var btn = document.createElement('button'); btn.type = 'button'; btn.className = 'dsel__type' + (t === type ? ' is-on' : ''); btn.setAttribute('role', 'radio'); btn.setAttribute('aria-checked', t === type);
          btn.innerHTML = '<strong>' + TYPE_LABEL[t] + '</strong><span>' + TYPE_HELP[t] + '</span>';
          btn.addEventListener('click', function () { type = t; render(); });
          typesEl.appendChild(btn);
        });
        var html = '<p class="dsel__load">Total load: <strong>' + total + 'W</strong> (' + w + 'W/m x ' + L + 'm)' + (bf.est ? ' <em>Estimate, based on the ' + b.wpm + 'W/m guide</em>' : '') + '</p>';
        if (L > b.maxLength) {
          res.innerHTML = html + '<p class="dsel__none">A run of ' + L + 'm is longer than our standard guide (' + b.maxLength + 'm). Please split it into shorter runs, or call us on 0203 916 6116 and we will size the drivers for you.</p>'; return;
        }
        var code = b.cells[type][L - 1], d = code && M.drivers[code];
        if (!d) { res.innerHTML = html + '<p class="dsel__none">We do not have a standard ' + TYPE_LABEL[type].toLowerCase() + ' driver for this load. Try another driver type, or call us on 0203 916 6116.</p>'; return; }
        res.innerHTML = html + '<div class="dsel__rec"><div><p class="dsel__recname">' + d.product + ' &middot; ' + d.size + '</p><p class="dsel__reccode">' + code + '</p><p class="dsel__recprice" data-price>&nbsp;</p></div><div class="dsel__recbtns"><button type="button" class="mcard__btn dsel__add" data-card-add="' + d.variantId + '"><span class="mcard__btn-label">Add driver to basket</span><span class="loading__spinner hidden"></span></button><a class="dsel__view" href="/products/' + d.handle + '?variant=' + d.variantId + '">View driver</a></div></div>';
        fetch('/products/' + d.handle + '.js').then(function (r) { return r.json(); }).then(function (p) {
          if (my !== token) return;
          var v = p.variants.filter(function (x) { return x.id === d.variantId; })[0]; var el = res.querySelector('[data-price]');
          if (v && el) el.innerHTML = money(v.price) + ' <small>ex VAT</small>' + (v.available ? '' : ' &middot; out of stock');
        }).catch(function () {});
      }
      wpmSel.addEventListener('change', render); lenIn.addEventListener('input', render);
      render();
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Driver selector",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right driver for your strip" },
    { "type": "text", "id": "intro", "label": "Intro text", "default": "Tell us how much strip you are using and the kind of control you want. We will recommend the driver." },
    { "type": "checkbox", "id": "standalone", "label": "Show without a strip (for pages)", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 4, "default": 16 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "default": 16 }
  ],
  "presets": [ { "name": "Driver selector" } ]
}
{% endschema %}

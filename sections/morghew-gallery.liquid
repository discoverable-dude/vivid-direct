{%- comment -%}
  Morghew Gallery — 4-column photo grid; "wide" images span two columns at 2:1.
{%- endcomment -%}

{{ 'morghew-editorial.css' | asset_url | stylesheet_tag }}

<section class="esec egallery" data-reveal>
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="esec__h esec__h--center">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="egallery__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          {%- liquid
            assign ratio = '1 / 1'
            if block.settings.wide
              assign ratio = '2 / 1'
            endif
          -%}
          <div class="eimg egallery__item{% if block.settings.wide %} egallery__item--wide{% endif %}" style="aspect-ratio: {{ ratio }};" {{ block.shopify_attributes }}>
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
            {%- if block.settings.tag != blank -%}<span class="ph__tag">{{ block.settings.tag }}</span>{%- endif -%}
          </div>
        {%- else -%}
          <div class="eimg eimg--ph egallery__item" style="aspect-ratio: 1 / 1;" {{ block.shopify_attributes }}>{% render 'morghew-icon', icon: 'leaf', size: 30 %}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Morghew Gallery",
  "tag": "section",
  "class": "m-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A year on the estate" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Caption tag" },
        { "type": "checkbox", "id": "wide", "label": "Wide (spans two columns)", "default": false }
      ]
    }
  ],
  "presets": [
    { "name": "Morghew Gallery", "blocks": [ { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" } ] }
  ]
}
{% endschema %}

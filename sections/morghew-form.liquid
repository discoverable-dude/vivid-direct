{%- comment -%}
  Morghew Custom Form — configurable contact form.
  Fields are blocks (text / email / phone / textarea). Submissions email the
  store's contact address via Shopify's {% form 'contact' %}. An "email" field
  becomes the reply-to; every other field is included in the message body.
{%- endcomment -%}

{{ 'morghew-page.css' | asset_url | stylesheet_tag }}

<section class="m-sec m-form m-sec--{{ section.settings.bg }}">
  <div class="m-sec__wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="m-form__head">
        {%- if section.settings.eyebrow != blank -%}<p class="m-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="m-heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.intro != blank -%}<div class="m-intro">{{ section.settings.intro }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- form 'contact', class: 'm-form__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="m-form__note m-form__note--success">{{ section.settings.success_message }}</p>
      {%- elsif form.errors -%}
        <p class="m-form__note m-form__note--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="m-form__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign f_label = block.settings.label
            assign f_name = 'contact[' | append: f_label | append: ']'
            if block.settings.type == 'email'
              assign f_name = 'contact[email]'
            endif
            assign f_id = 'MForm-' | append: section.id | append: '-' | append: forloop.index
          -%}
          <div class="m-form__field{% if block.settings.type == 'textarea' or block.settings.width == 'full' %} m-form__field--full{% endif %}" {{ block.shopify_attributes }}>
            <label class="m-form__label" for="{{ f_id }}">
              {{ f_label }}{% if block.settings.required %}<span class="m-req"> *</span>{% endif %}
            </label>
            {%- if block.settings.type == 'textarea' -%}
              <textarea
                id="{{ f_id }}"
                class="m-form__textarea"
                name="{{ f_name }}"
                placeholder="{{ block.settings.placeholder }}"
                {% if block.settings.required %}required{% endif %}
              ></textarea>
            {%- else -%}
              <input
                id="{{ f_id }}"
                class="m-form__input"
                type="{{ block.settings.type }}"
                name="{{ f_name }}"
                placeholder="{{ block.settings.placeholder }}"
                {% if block.settings.type == 'email' %}autocomplete="email"{% endif %}
                {% if block.settings.required %}required{% endif %}
              >
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <button type="submit" class="m-btn m-btn--primary m-form__submit">{{ section.settings.submit_label }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom form",
  "tag": "section",
  "class": "m-section",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [ { "value": "paper", "label": "Paper" }, { "value": "paper2", "label": "Paper (deeper)" }, { "value": "cream", "label": "Cream (textured)" } ], "default": "paper" },
    { "type": "header", "content": "Header (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Fill in the form below and we'll get back to you within one working day.</p>" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Send enquiry" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks — we've got your message and will be in touch shortly." }
  ],
  "blocks": [
    {
      "type": "field",
      "name": "Field",
      "settings": [
        { "type": "select", "id": "type", "label": "Field type", "options": [ { "value": "text", "label": "Text" }, { "value": "email", "label": "Email (reply-to)" }, { "value": "tel", "label": "Phone" }, { "value": "textarea", "label": "Message (multi-line)" } ], "default": "text" },
        { "type": "text", "id": "label", "label": "Label", "default": "Field label" },
        { "type": "text", "id": "placeholder", "label": "Placeholder" },
        { "type": "checkbox", "id": "required", "label": "Required", "default": false },
        { "type": "select", "id": "width", "label": "Width", "options": [ { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" } ], "default": "half", "info": "Message fields are always full width." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom form",
      "blocks": [
        { "type": "field", "settings": { "type": "text", "label": "Your name", "placeholder": "Jane Smith", "required": true, "width": "half" } },
        { "type": "field", "settings": { "type": "text", "label": "Business name", "placeholder": "The Crown, Tenterden", "width": "half" } },
        { "type": "field", "settings": { "type": "email", "label": "Email address", "placeholder": "jane@example.com", "required": true, "width": "half" } },
        { "type": "field", "settings": { "type": "tel", "label": "Phone (optional)", "placeholder": "+44 7700 000000", "width": "half" } },
        { "type": "field", "settings": { "type": "textarea", "label": "Tell us what you need", "placeholder": "Varieties you're interested in, volumes, delivery area…", "required": true } }
      ]
    }
  ]
}
{% endschema %}

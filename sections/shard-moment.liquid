{{ 'morghew-home.css' | asset_url | stylesheet_tag }}
<section class="shard-moment" id="shard-{{ section.id }}">

  {%- if section.settings.image != blank -%}
    <img
      class="shard-moment__bg"
      src="{{ section.settings.image | image_url: width: 2000 }}"
      alt="{{ section.settings.image.alt | escape }}"
      loading="lazy"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
      style="opacity: {{ section.settings.image_opacity | divided_by: 100.0 }}">
  {%- endif -%}

  <div class="shard-moment__overlay"></div>

  <div class="wrap">
    <div class="shard-moment__inner">

      {%- if section.settings.title != blank -%}
        <h2 class="shard-moment__h" data-reveal>{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="shard-moment__stats" data-reveal>
          {%- for block in section.blocks -%}
            <div class="shard-stat" {{ block.shopify_attributes }}>
              {%- if block.settings.number != blank -%}
                <span class="shard-stat__num">{{ block.settings.number | escape }}</span>
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <span class="shard-stat__label">{{ block.settings.label | escape }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shard moment",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "label": "Image opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Headline",
      "default": "From Kent field to London table in under 24 hours."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number / value",
          "default": "30"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Heritage varieties"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shard moment",
      "blocks": [
        {
          "type": "stat",
          "settings": { "number": "30", "label": "Heritage varieties" }
        },
        {
          "type": "stat",
          "settings": { "number": "1 day", "label": "Field to packing" }
        },
        {
          "type": "stat",
          "settings": { "number": "The Shard", "label": "On the menu" }
        }
      ]
    }
  ]
}
{% endschema %}

{{ 'morghew-sections.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  collection-estate.liquid — generic estate-produce collection (game, firewood, oils, flour, honey…).
  Hero + optional category link tabs + product grid (card-potato handles multi-option products) +
  trust strip. Reuses the pshop-* visual language. Assign via the "estate" collection template.
{%- endcomment -%}

{%- comment -%} ─── HERO ─────────────────────────────────── {%- endcomment -%}
{%- comment -%} Background image: the collection's own image (admin → Collections → [name]),
    with a section image picker as fallback for collections that have none. {%- endcomment -%}
{%- assign _hero_img = blank -%}
{%- if section.settings.use_collection_image and collection.image != blank -%}
  {%- assign _hero_img = collection.image -%}
{%- elsif section.settings.hero_image != blank -%}
  {%- assign _hero_img = section.settings.hero_image -%}
{%- endif -%}
<div class="pshop-hero ecoll-hero{% if _hero_img != blank %} ecoll-hero--img{% endif %}">
  {%- if _hero_img != blank -%}
    <img
      class="ecoll-hero__bg"
      src="{{ _hero_img | image_url: width: 2200 }}"
      srcset="{{ _hero_img | image_url: width: 900 }} 900w, {{ _hero_img | image_url: width: 1500 }} 1500w, {{ _hero_img | image_url: width: 2200 }} 2200w"
      sizes="100vw"
      alt="{{ _hero_img.alt | default: collection.title | escape }}"
      width="{{ _hero_img.width }}"
      height="{{ _hero_img.height }}"
      loading="eager"
      fetchpriority="high"
      style="opacity: {{ section.settings.image_opacity | default: 45 | divided_by: 100.0 }};"
    >
    <div class="ecoll-hero__scrim" aria-hidden="true"></div>
  {%- endif -%}
  <div class="wrap">

    <nav class="pshop-crumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="pshop-crumb__sep">›</span>
      <span>{{ collection.title }}</span>
    </nav>

    <h1 class="pshop-heading">{{ section.settings.heading | default: collection.title | escape }}</h1>

    {%- comment -%} Unique per-collection copy = the collection's own Description (admin → Collections →
        Description). Long copy collapses to a char limit with a Read more toggle; setting is a fallback. {%- endcomment -%}
    {%- assign _sub = collection.description -%}
    {%- if _sub == blank -%}{%- assign _sub = section.settings.subtext -%}{%- endif -%}
    {%- if _sub != blank -%}
      {%- assign _limit = section.settings.subtext_limit -%}
      {%- assign _plain = _sub | strip_html -%}
      {%- if _limit > 0 and _plain.size > _limit -%}
        <div class="pshop-sub" data-readmore>
          <div class="pshop-sub__short">{{ _plain | truncate: _limit }}</div>
          <div class="pshop-sub__full" hidden>{{ _sub }}</div>
          <button type="button" class="pshop-sub__toggle" aria-expanded="false">Read more</button>
        </div>
      {%- else -%}
        <div class="pshop-sub">{{ _sub }}</div>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Optional category tabs — customizer link blocks (label / sub-label / icon / destination). {%- endcomment -%}
    {%- assign category_tabs = section.blocks | where: "type", "variety_tab" -%}
    {%- if category_tabs.size > 0 -%}
      <div class="pshop-tabs" role="list" aria-label="Shop by category">
        {%- for block in category_tabs -%}
          <a href="{{ block.settings.link | default: '#' }}"
             class="pshop-tab{% if block.settings.link != blank and block.settings.link == request.path %} pshop-tab--active{% endif %}"
             role="listitem" {{ block.shopify_attributes }}>
            <div class="pshop-tab__icon">{%- render 'morghew-icon', icon: block.settings.icon, size: 24 -%}</div>
            <span class="pshop-tab__label">{{ block.settings.label | escape }}</span>
            {%- if block.settings.sublabel != blank -%}<span class="pshop-tab__sub">{{ block.settings.sublabel | escape }}</span>{%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{%- comment -%} ─── RESULTS ──────────────────────────────── {%- endcomment -%}
<div class="pshop-results">
  <div class="wrap">

    <div class="pshop-bar">
      <div class="pshop-count">
        <span class="pshop-count__n">{{ collection.products.size }}</span>
        <span class="pshop-count__label">{{ section.settings.count_label | default: 'products' }}</span>
      </div>
    </div>

    <div class="pshop-grid" id="ecoll-grid">
      {%- for product in collection.products -%}
        <div class="pshop-item">{%- render 'card-potato', product: product -%}</div>
      {%- else -%}
        <p class="pshop-empty">No products in this collection yet.</p>
      {%- endfor -%}
    </div>

  </div>
</div>

{%- comment -%} ─── TRUST STRIP ───────────────────────────── {%- endcomment -%}
{%- if section.settings.trust_1_title != blank or section.settings.trust_2_title != blank or section.settings.trust_3_title != blank -%}
<div class="pshop-trust">
  <div class="wrap pshop-trust__inner">
    {%- if section.settings.trust_1_title != blank -%}
      <div class="pshop-trust__item">
        <div class="pshop-trust__icon">{%- render 'morghew-icon', icon: 'leaf', size: 28 -%}</div>
        <div>
          <p class="pshop-trust__title">{{ section.settings.trust_1_title }}</p>
          <p class="pshop-trust__sub">{{ section.settings.trust_1_sub }}</p>
        </div>
      </div>
    {%- endif -%}
    {%- if section.settings.trust_2_title != blank -%}
      <div class="pshop-trust__item">
        <div class="pshop-trust__icon">{%- render 'morghew-icon', icon: 'truck', size: 28 -%}</div>
        <div>
          <p class="pshop-trust__title">{{ section.settings.trust_2_title }}</p>
          <p class="pshop-trust__sub">{{ section.settings.trust_2_sub }}</p>
        </div>
      </div>
    {%- endif -%}
    {%- if section.settings.trust_3_title != blank -%}
      <div class="pshop-trust__item">
        <div class="pshop-trust__icon">{%- render 'morghew-icon', icon: 'pin', size: 28 -%}</div>
        <div>
          <p class="pshop-trust__title">{{ section.settings.trust_3_title }}</p>
          <p class="pshop-trust__sub">{{ section.settings.trust_3_sub }}</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

<script>
  (function () {
    document.querySelectorAll('[data-readmore]').forEach(function (box) {
      var btn = box.querySelector('.pshop-sub__toggle');
      var short = box.querySelector('.pshop-sub__short');
      var full = box.querySelector('.pshop-sub__full');
      if (!btn || !short || !full) return;
      btn.addEventListener('click', function () {
        var expanded = btn.getAttribute('aria-expanded') !== 'true';
        short.hidden = expanded;
        full.hidden = !expanded;
        btn.textContent = expanded ? 'Read less' : 'Read more';
        btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Estate collection",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Hero image" },
    { "type": "checkbox", "id": "use_collection_image", "label": "Use the collection's image", "default": true, "info": "The image set on each collection in admin (Collections → [name] → Image). Each collection gets its own hero automatically." },
    { "type": "image_picker", "id": "hero_image", "label": "Fallback image", "info": "Shown when a collection has no image of its own, or when the box above is unticked." },
    { "type": "range", "id": "image_opacity", "label": "Image opacity", "min": 10, "max": 100, "step": 5, "default": 45, "info": "Lower blends the photo into the deep green; higher shows more photo." },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the collection title if left blank" },
    { "type": "textarea", "id": "subtext", "label": "Fallback subtext", "info": "For unique copy per collection, edit each collection's Description in admin (Collections → [name] → Description). This is only shown when a collection has no description." },
    { "type": "range", "id": "subtext_limit", "label": "Intro character limit", "min": 0, "max": 600, "step": 20, "default": 240, "info": "Copy longer than this collapses behind a Read more button. Set to 0 to always show the full text." },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "products" },
    { "type": "header", "content": "Trust strip" },
    { "type": "text", "id": "trust_1_title", "label": "Item 1 title", "default": "Grown &amp; made by hand" },
    { "type": "text", "id": "trust_1_sub", "label": "Item 1 subtitle", "default": "On the estate in Kent" },
    { "type": "text", "id": "trust_2_title", "label": "Item 2 title", "default": "Free over £40" },
    { "type": "text", "id": "trust_2_sub", "label": "Item 2 subtitle", "default": "Tracked UK delivery" },
    { "type": "text", "id": "trust_3_title", "label": "Item 3 title", "default": "Tenterden, Kent" },
    { "type": "text", "id": "trust_3_sub", "label": "Item 3 subtitle", "default": "A working farming estate" }
  ],
  "blocks": [
    {
      "type": "variety_tab",
      "name": "Category tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Game" },
        { "type": "text", "id": "sublabel", "label": "Sub-label" },
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "wild-game",
          "options": [
            { "value": "wild-game", "label": "Game" }, { "value": "firewood", "label": "Firewood" },
            { "value": "rapeseed-oil", "label": "Oil" }, { "value": "flour", "label": "Flour" },
            { "value": "honey", "label": "Honey" }, { "value": "potato-seeds", "label": "Seeds" },
            { "value": "bottle", "label": "Bottle" }, { "value": "leaf", "label": "Leaf" },
            { "value": "potato", "label": "Potato" }, { "value": "wheat", "label": "Wheat ear" },
            { "value": "tree", "label": "Oak tree" }, { "value": "pheasant", "label": "Game bird" },
            { "value": "fish", "label": "Fish" }, { "value": "bird", "label": "Birds in flight" },
            { "value": "stall", "label": "Market stall" }, { "value": "camera", "label": "Camera" },
            { "value": "pin", "label": "Map pin" }, { "value": "truck", "label": "Delivery truck" },
            { "value": "clock", "label": "Clock" }, { "value": "book", "label": "Recipe book" },
            { "value": "roast", "label": "Roast" }, { "value": "mash", "label": "Mash" },
            { "value": "chip", "label": "Chips" }, { "value": "jacket", "label": "Jacket" },
            { "value": "boil", "label": "Boil" }, { "value": "steam", "label": "Steam" },
            { "value": "salad", "label": "Salad" }, { "value": "wedge", "label": "Wedges" },
            { "value": "dauphinoise", "label": "Dauphinoise" }, { "value": "star", "label": "Star" },
            { "value": "flame", "label": "Flame" }
          ]
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Estate collection" }]
}
{% endschema %}

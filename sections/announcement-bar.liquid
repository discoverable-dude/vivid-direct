{%- comment -%}
  Announcement bar — static row (legacy) or one-at-a-time rotation.
  Messages come from "message" blocks; with no blocks it falls back to
  the original left/mid/right settings so existing content keeps working.
{%- endcomment -%}

{%- assign _blocks = section.blocks | where: "type", "message" -%}
{%- assign _mode = section.settings.mode | default: 'rotate' -%}

<div
  class="morgbar{% if _mode == 'rotate' %} morgbar--rotate{% endif %}"
  id="morgbar-{{ section.id }}"
  data-mode="{{ _mode }}"
  data-interval="{{ section.settings.interval | default: 5 }}"
  role="region"
  aria-label="{{ 'sections.header.announcement' | t }}"
>
  {%- if _blocks.size > 0 -%}
    {%- for block in _blocks -%}
      {%- if block.settings.text != blank -%}
        {%- if block.settings.link != blank -%}
          <a class="morgbar__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</a>
        {%- else -%}
          <span class="morgbar__item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- if section.settings.left_text != blank -%}
      <span class="morgbar__item">{{ section.settings.left_text | escape }}</span>
    {%- endif -%}
    {%- if section.settings.mid_text != blank -%}
      <span class="morgbar__item morgbar__item--mid">{{ section.settings.mid_text | escape }}</span>
    {%- endif -%}
    {%- if section.settings.right_text != blank -%}
      <span class="morgbar__item">{{ section.settings.right_text | escape }}</span>
    {%- endif -%}
  {%- endif -%}
</div>

{% style %}
  .morgbar__item { color: inherit; text-decoration: none; }
  a.morgbar__item:hover { text-decoration: underline; text-underline-offset: 3px; }
  .morgbar--rotate {
    display: grid;
    justify-items: center;
    text-align: center;
    min-height: 30px;
  }
  .morgbar--rotate .morgbar__item {
    display: block;
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(5px);
    transition: opacity 0.45s ease, transform 0.45s ease;
    pointer-events: none;
    line-height: 1.35;
  }
  .morgbar--rotate .morgbar__item.is-on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .morgbar--rotate .morgbar__item { transition: none; transform: none; }
  }
{% endstyle %}

<script>
  (() => {
    const bar = document.getElementById('morgbar-{{ section.id }}');
    if (!bar || bar.dataset.mode !== 'rotate') return;
    const items = bar.querySelectorAll('.morgbar__item');
    if (!items.length) return;
    items[0].classList.add('is-on');
    if (items.length < 2) return;
    let i = 0;
    let paused = false;
    bar.addEventListener('mouseenter', () => { paused = true; });
    bar.addEventListener('mouseleave', () => { paused = false; });
    bar.addEventListener('focusin', () => { paused = true; });
    bar.addEventListener('focusout', () => { paused = false; });
    const interval = Math.max(2, parseInt(bar.dataset.interval, 10) || 5) * 1000;
    setInterval(() => {
      if (paused || document.hidden) return;
      items[i].classList.remove('is-on');
      i = (i + 1) % items.length;
      items[i].classList.add('is-on');
    }, interval);
  })();
</script>

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Style",
      "default": "rotate",
      "options": [
        { "value": "rotate", "label": "Rotate one message at a time" },
        { "value": "all", "label": "Show all side by side" }
      ]
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Seconds per message",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Messages",
      "info": "Add Message blocks for the list (each can link somewhere). If there are no blocks, the three fields below are used instead."
    },
    {
      "type": "text",
      "id": "left_text",
      "label": "Left message",
      "default": "Free UK delivery over £40"
    },
    {
      "type": "text",
      "id": "mid_text",
      "label": "Centre message",
      "default": "Grown & packed by hand · Tenterden, Kent"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "Right message",
      "default": "As served at The Shard"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK delivery over £40" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  Morghew Text + Accordion — two columns: eyebrow/heading left, accordion right.
  Optional background image + opacity. Customizer-managed (settings + blocks).
{%- endcomment -%}

{{ 'morghew-page.css' | asset_url | stylesheet_tag }}

{%- assign _opacity = section.settings.image_opacity | divided_by: 100.0 -%}

<section class="m-sec m-txacc m-sec--{{ section.settings.bg }}">
  {%- if section.settings.bg_image != blank -%}
    <img class="m-txacc__bg" src="{{ section.settings.bg_image | image_url: width: 2400 }}" alt="" aria-hidden="true" width="{{ section.settings.bg_image.width }}" height="{{ section.settings.bg_image.height }}" loading="lazy" style="opacity: {{ _opacity }};">
  {%- endif -%}

  <div class="m-sec__wrap m-txacc__grid">
    <div class="m-txacc__head">
      {%- if section.settings.eyebrow != blank -%}<p class="m-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="m-heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<div class="m-intro">{{ section.settings.intro }}</div>{%- endif -%}
    </div>

    <div class="m-txacc__list">
      {%- for block in section.blocks -%}
        <details class="m-txacc__item"{% if block.settings.open_by_default %} open{% endif %} {{ block.shopify_attributes }}>
          <summary class="m-txacc__q">
            {{ block.settings.title }}
            <svg class="m-faq__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="m-txacc__a">{{ block.settings.body }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Morghew Text + Accordion",
  "tag": "section",
  "class": "m-section",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [ { "value": "paper", "label": "Paper" }, { "value": "paper2", "label": "Paper (deeper)" }, { "value": "cream", "label": "Cream (textured)" }, { "value": "dark", "label": "Estate green" } ], "default": "paper" },
    { "type": "header", "content": "Background image (optional)" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "range", "id": "image_opacity", "label": "Image opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Left column" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Care and keeping" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Keeping them at their best" },
    { "type": "richtext", "id": "intro", "label": "Intro text" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Accordion item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Section title" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Body text for this accordion item.</p>" },
        { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Morghew Text + Accordion",
      "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" } ]
    }
  ]
}
{% endschema %}

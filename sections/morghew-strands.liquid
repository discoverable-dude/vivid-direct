{%- comment -%}
  Morghew Strands — linked card grid (3-col; 3 or 6 cards). Cards without an
  image get a soil-tone placeholder with a leaf mark.
{%- endcomment -%}

{{ 'morghew-editorial.css' | asset_url | stylesheet_tag }}

<section class="esec estrands" data-reveal>
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow estrands__eb">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="esec__h esec__h--center">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<p class="esec__intro">{{ section.settings.intro }}</p>{%- endif -%}
    <div class="estrands__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link_url | default: '#' }}" class="strandcard" {{ block.shopify_attributes }}>
          <div class="strandcard__media">
            {%- if block.settings.image != blank -%}
              <div class="eimg" style="aspect-ratio: 3 / 2;">
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              </div>
            {%- else -%}
              <div class="eimg eimg--ph" style="aspect-ratio: 3 / 2;">{% render 'morghew-icon', icon: 'leaf', size: 30 %}</div>
            {%- endif -%}
          </div>
          <div class="strandcard__body">
            <h3 class="strandcard__h">{{ block.settings.title }}</h3>
            <p class="strandcard__p">{{ block.settings.text }}</p>
            <span class="strandcard__link">{{ block.settings.link_label | default: 'Read more' }}{% render 'morghew-icon', icon: 'arrow', size: 16 %}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Card strand",
  "tag": "section",
  "class": "m-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Beyond the potato" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One estate, many strands" },
    { "type": "textarea", "id": "intro", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty for a leaf-mark placeholder." },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A sentence or two about this strand of the estate." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Read more" },
        { "type": "url", "id": "link_url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Card strand", "blocks": [ { "type": "card" }, { "type": "card" }, { "type": "card" } ] }
  ]
}
{% endschema %}

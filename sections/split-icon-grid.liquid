{%- comment -%}
  Split icon grid — large image on one side, a 2x2 grid of bordered dark
  cards (outline icon + heading + text) on the other. Matches the sister
  site's "How We Work" card layout.
{%- endcomment -%}

<div class="sig color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="sig__head">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="t-h1 sig__h">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="sig__row{% if section.settings.image_position == 'right' %} sig__row--rev{% endif %}">
      <div class="sig__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy">
        {%- endif -%}
      </div>
      <div class="sig__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            <div class="sig__card" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="sig__icon">{%- render 'morghew-icon', icon: block.settings.icon, size: 28 -%}</span>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}<h3 class="sig__card-h">{{ block.settings.heading }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<p class="sig__card-t">{{ block.settings.text }}</p>{%- endif -%}
              <span class="sig__light" aria-hidden="true"></span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% style %}
  .sig__head { margin-bottom: 28px; }
  .sig__h { margin: 6px 0 0; }
  .sig__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: stretch;
  }
  .sig__row--rev { direction: rtl; }
  .sig__row--rev > * { direction: ltr; }
  @media screen and (max-width: 899px) {
    .sig__row { grid-template-columns: 1fr; }
  }
  .sig__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .sig__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .sig__media:hover img { transform: scale(1.05); }
  .sig__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  @media screen and (max-width: 480px) {
    .sig__grid { grid-template-columns: 1fr; }
  }
  .sig__card {
    position: relative;
    border: 1px solid rgba(var(--color-foreground), 0.12);
    border-radius: var(--radius);
    background: rgba(var(--color-foreground), 0.03);
    padding: 22px 20px;
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }
  .sig__card:hover {
    transform: translateY(-4px);
    border-color: var(--cta);
    background: rgba(var(--color-foreground), 0.05);
  }
  .sig__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgb(var(--color-button));
    margin-bottom: 14px;
    border-radius: 50%;
    transition: transform 0.25s ease, box-shadow 0.35s ease;
  }
  .sig__card:hover .sig__icon {
    transform: scale(1.1);
    box-shadow: 0 0 0 10px color-mix(in srgb, var(--cta) 16%, transparent), 0 0 24px 4px color-mix(in srgb, var(--cta) 45%, transparent);
  }
  .sig__icon svg { width: 28px; height: 28px; }
  .sig__light {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--cta);
    box-shadow: 0 0 12px 2px color-mix(in srgb, var(--cta) 70%, transparent);
    transition: width 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .sig__card:hover .sig__light { width: 100%; }
  .sig__card-h {
    font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 16px;
    margin: 0 0 6px;
  }
  .sig__card-t {
    font-size: 13.5px;
    line-height: 1.55;
    color: rgba(var(--color-foreground), 0.68);
    margin: 0;
  }
{% endstyle %}

{% schema %}
{
  "name": "Split icon grid",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How We Help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Partner, Not Just a Supplier" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "t:sections.all.padding.padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.all.padding.padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Delivery" },
          { "value": "phone", "label": "Support" },
          { "value": "check", "label": "Trust" },
          { "value": "package", "label": "Range" },
          { "value": "clock", "label": "Speed" },
          { "value": "mail", "label": "Contact" },
          { "value": "eye", "label": "Vision" },
          { "value": "lightbulb", "label": "Expertise" },
          { "value": "users", "label": "Team" },
          { "value": "house", "label": "Residential" },
          { "value": "building", "label": "Commercial" }
        ], "default": "check" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Feature" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Split icon grid",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  Morghew Timeline — year / dot / rule history list (used on About).
{%- endcomment -%}

{{ 'morghew-editorial.css' | asset_url | stylesheet_tag }}

<section class="esec etimeline" data-reveal>
  <div class="wrap etimeline__wrap">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="esec__h">{{ section.settings.heading }}</h2>{%- endif -%}
    <ol class="etimeline__list">
      {%- for block in section.blocks -%}
        <li class="etimeline__item" {{ block.shopify_attributes }}>
          <span class="etimeline__year">{{ block.settings.year }}</span>
          <div class="etimeline__c">
            <h3 class="etimeline__h">{{ block.settings.title }}</h3>
            <p class="etimeline__p">{{ block.settings.text }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Morghew Timeline",
  "tag": "section",
  "class": "m-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story, briefly" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four generations, one patch of Kent" }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "Entry",
      "settings": [
        { "type": "text", "id": "year", "label": "Year", "default": "1946" },
        { "type": "text", "id": "title", "label": "Title", "default": "A milestone" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A sentence or two about what happened." }
      ]
    }
  ],
  "presets": [
    { "name": "Morghew Timeline", "blocks": [ { "type": "entry" }, { "type": "entry" }, { "type": "entry" } ] }
  ]
}
{% endschema %}

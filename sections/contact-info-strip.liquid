{%- comment -%}
  Contact info strip — 3-across dark cards with icon, bold heading and
  a short caption. Used to close out content pages with quick contact
  routes (call / email / FAQs etc).
{%- endcomment -%}

{{ 'vivid-editorial.css' | asset_url | stylesheet_tag }}

<section class="cis">
  <div class="wrap cis__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'box' -%}
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="cis__box" {{ block.shopify_attributes }}>
        {%- else -%}<div class="cis__box" {{ block.shopify_attributes }}>
        {%- endif -%}
          {%- if block.settings.icon != "none" -%}
            <span class="cis__icon">{%- render 'vivid-icon', icon: block.settings.icon, size: 26 -%}</span>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}<h3 class="cis__heading">{{ block.settings.heading }}</h3>{%- endif -%}
          {%- if block.settings.detail != blank -%}<p class="cis__detail">{{ block.settings.detail }}</p>{%- endif -%}
          {%- if block.settings.caption != blank -%}<p class="cis__caption">{{ block.settings.caption }}</p>{%- endif -%}
        {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% style %}
  .cis__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding-block: var(--sec-pad-sm);
  }
  @media screen and (max-width: 749px) {
    .cis__grid { grid-template-columns: 1fr; }
  }
  .cis__box {
    display: block;
    text-align: center;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 32px 24px;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  a.cis__box:hover { transform: translateY(-3px); border-color: var(--cta); }
  .cis__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-pill);
    background: var(--cta);
    color: var(--footer-bg);
    margin-bottom: 14px;
  }
  .cis__heading {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 20px;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .cis__detail {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 20px;
    color: var(--cta);
    margin: 0 0 8px;
  }
  .cis__caption {
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0;
  }
{% endstyle %}

{% schema %}
{
  "name": "Contact info strip",
  "tag": "section",
  "class": "m-section",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "box",
      "name": "Box",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "phone", "options": [
          { "value": "none", "label": "No icon" },
          { "value": "phone", "label": "Phone" },
          { "value": "mail", "label": "Mail" },
          { "value": "check", "label": "Check" },
          { "value": "clock", "label": "Clock" }
        ] },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Call us" },
        { "type": "text", "id": "detail", "label": "Detail (bold line)", "default": "0203 916 6116" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    { "name": "Contact info strip", "blocks": [ { "type": "box" }, { "type": "box" }, { "type": "box" } ] }
  ]
}
{% endschema %}

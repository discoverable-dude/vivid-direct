    { "type": "text", "id": "current_label", "label": "Label for this collection", "info": "Leave empty to use the collection's own title." },
    {
      "type": "select", "id": "current_icon", "label": "Icon for this collection", "default": "none",
      "options": [
        { "value": "none", "label": "No icon" },
        { "value": "kitchen", "label": "Kitchen" },
        { "value": "bathroom", "label": "Bathroom" },
        { "value": "downlight", "label": "Downlight" },
        { "value": "lamp", "label": "Lamp" },
        { "value": "lightbulb", "label": "Bulb" },
        { "value": "garden-light", "label": "Garden light" },
        { "value": "led-strip", "label": "LED strip" },
        { "value": "house", "label": "House" },
        { "value": "building", "label": "Building" },
        { "value": "eye", "label": "Eye" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "camera", "label": "Camera" },
        { "value": "truck", "label": "Delivery truck" },
        { "value": "pin", "label": "Pin" },
        { "value": "search", "label": "Search" },
        { "value": "phone", "label": "Phone" },
        { "value": "mail", "label": "Mail" },
        { "value": "clock", "label": "Clock" },
        { "value": "check", "label": "Check" },
        { "value": "package", "label": "Package" },
        { "value": "plus", "label": "Plus" },
        { "value": "users", "label": "Users" },
        { "value": "star", "label": "Star" }
      ]
    },
    { "type": "text", "id": "aria_label", "label": "Accessibility label", "default": "Shop other collections" },
    { "type": "header", "content": "Colour" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Cross-sell tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Neon Flex" },
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "none",
          "options": [
            { "value": "none", "label": "No icon" },
            { "value": "kitchen", "label": "Kitchen" },
            { "value": "bathroom", "label": "Bathroom" },
            { "value": "downlight", "label": "Downlight" },
            { "value": "lamp", "label": "Lamp" },
            { "value": "lightbulb", "label": "Bulb" },
            { "value": "garden-light", "label": "Garden light" },
            { "value": "led-strip", "label": "LED strip" },
            { "value": "house", "label": "House" },
            { "value": "building", "label": "Building" },
            { "value": "eye", "label": "Eye" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "camera", "label": "Camera" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "pin", "label": "Pin" },
            { "value": "search", "label": "Search" },
            { "value": "phone", "label": "Phone" },
            { "value": "mail", "label": "Mail" },
            { "value": "clock", "label": "Clock" },
            { "value": "check", "label": "Check" },
            { "value": "package", "label": "Package" },
            { "value": "plus", "label": "Plus" },
            { "value": "users", "label": "Users" },
            { "value": "star", "label": "Star" }
          ]
        },
        { "type": "url", "id": "link", "label": "Link", "info": "Usually another collection." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection cross-nav tabs"
    }
  ]
}
{% endschema %}

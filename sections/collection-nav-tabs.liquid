{%- comment -%}
  Collection cross-nav tabs — a row of tab pills at the top of a collection
  page for cross-selling into other collections (e.g. show "Neon Flex" and
  "LED Strip" as tabs on the Downlights collection). Ported from the old
  Morghew theme's cook-method variety tabs, rebuilt with lighting-relevant
  icons and no flesh/dietary filtering — those never applied here.

  The wrapper always renders (rather than being conditional on block count)
  so the section stays selectable/editable in the theme editor even before
  a tab block has been added — a section whose root markup disappears based
  on block count can make the editor lose track of it entirely.
{%- endcomment -%}

{{ 'vivid-sections.css' | asset_url | stylesheet_tag }}

{%- assign nav_tabs = section.blocks | where: 'type', 'tab' -%}
{%- assign has_content = false -%}
{%- if section.settings.show_current or nav_tabs.size > 0 -%}{%- assign has_content = true -%}{%- endif -%}

{%- if has_content or request.design_mode -%}

{%- capture scheme_vars -%}
  --paper: rgb(var(--color-background)); --ink: rgb(var(--color-foreground)); --ink-soft: rgba(var(--color-foreground), 0.68); --line: rgba(var(--color-foreground), 0.14); --line-strong: rgba(var(--color-foreground), 0.28);
  padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;
{%- endcapture -%}

<div class="color-{{ section.settings.color_scheme }} gradient" style="{{ scheme_vars }}">
  <div class="wrap">
    <nav class="xnav-tabs" aria-label="{{ section.settings.aria_label | default: 'Shop other collections' }}">
      {%- if section.settings.show_current -%}
        <span class="xnav-tab xnav-tab--active">
          {%- if section.settings.current_icon != 'none' -%}
            <span class="xnav-tab__icon">{%- render 'vivid-icon', icon: section.settings.current_icon, size: 16 -%}</span>
          {%- endif -%}
          <span class="xnav-tab__label">{{ section.settings.current_label | default: collection.title }}</span>
        </span>
      {%- endif -%}
      {%- for block in nav_tabs -%}
        {%- assign _is_active = false -%}
        {%- if block.settings.link != blank and block.settings.link == request.path -%}{%- assign _is_active = true -%}{%- endif -%}
        <a href="{{ block.settings.link | default: '#' }}"
           class="xnav-tab{% if _is_active %} xnav-tab--active{% endif %}"
           {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="xnav-tab__icon">{%- render 'vivid-icon', icon: block.settings.icon, size: 16 -%}</span>
          {%- endif -%}
          <span class="xnav-tab__label">{{ block.settings.label | escape }}</span>
        </a>
      {%- endfor -%}
      {%- if nav_tabs.size == 0 and request.design_mode -%}
        <span class="xnav-tab__hint">Add a "Cross-sell tab" block to link to another collection.</span>
      {%- endif -%}
    </nav>
  </div>
</div>

{%- endif -%}

{% schema %}
{
  "name": "Collection cross-nav tabs",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["collection"]

{{ 'morghew-recipe-feature.css' | asset_url | stylesheet_tag }}
<section class="recipe-feature" id="recipe-{{ section.id }}">
  <div class="wrap">

    <div class="recipe-feature__head" data-reveal>
      <h2 class="recipe-feature__title">{{ section.settings.title | escape }}</h2>
      {%- if section.settings.view_all_url != blank -%}
        <a href="{{ section.settings.view_all_url }}" class="recipe-feature__viewall">
          {{ section.settings.view_all_label | default: 'All recipes' | escape }}
          {% render 'morghew-icon', icon: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="recipe-feature__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            # Pick a recipe article and everything pulls through from it;
            # the manual fields below act as per-card overrides.
            assign _a = block.settings.article
            assign _url = block.settings.url
            assign _img = block.settings.image
            assign _title = block.settings.title
            assign _time = block.settings.cook_time
            assign _note = block.settings.variety_note
            if _a != blank
              if _url == blank
                assign _url = _a.url
              endif
              if _img == blank
                assign _img = _a.image
              endif
              if _title == blank
                assign _title = _a.title
              endif
              if _time == blank
                assign _time = _a.metafields.custom.recipe_cook_time.value
                assign _serves = _a.metafields.custom.recipe_serves.value
                if _time != blank and _serves != blank
                  assign _time = _time | append: ' · Serves ' | append: _serves
                endif
              endif
              if _note == blank
                # "Best with X": block's product picker first, then the
                # recipe's featured product, then the first Made-with
                # product, then the subtitle.
                assign _fp = block.settings.best_with_product
                if _fp == blank
                  assign _fp = _a.metafields.custom.recipe_featured_product.value
                endif
                if _fp == blank
                  assign _fp = _a.metafields.custom.recipe_shop_items.value | first
                endif
                if _fp != blank
                  assign _fp_title = _fp.title | remove: '*New Season*' | strip
                  assign _note = 'Best with ' | append: _fp_title
                else
                  assign _note = _a.metafields.descriptors.subtitle.value
                endif
              endif
            endif
            # picker also works on cards with no article chosen
            if _note == blank and block.settings.best_with_product != blank
              assign _fp_title = block.settings.best_with_product.title | remove: '*New Season*' | strip
              assign _note = 'Best with ' | append: _fp_title
            endif
          -%}
          <a
            href="{{ _url | default: '#' }}"
            class="recipe-card"
            data-reveal
            {{ block.shopify_attributes }}>

            <div class="recipe-card__photo">
              {%- if _img != blank -%}
                <img
                  src="{{ _img | image_url: width: 900 }}"
                  alt="{{ _img.alt | default: _title | escape }}"
                  loading="lazy"
                  width="{{ _img.width }}"
                  height="{{ _img.height }}">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

              {%- if _time != blank -%}
                <span class="recipe-card__time">
                  {% render 'morghew-icon', icon: 'clock' %}
                  {{ _time | escape }}
                </span>
              {%- endif -%}
            </div>

            <div class="recipe-card__cap">
              {%- if _title != blank -%}
                <h3 class="recipe-card__name">{{ _title | escape }}</h3>
              {%- endif -%}
              {%- if _note != blank -%}
                <p class="recipe-card__variety">{{ _note | escape }}</p>
              {%- endif -%}
            </div>

          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Recipe feature",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "From the kitchen"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "All recipes"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all URL"
    }
  ],
  "blocks": [
    {
      "type": "recipe",
      "name": "Recipe card",
      "limit": 2,
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Recipe article",
          "info": "Pick a recipe from the blog — its photo, title, cook time and subtitle pull through automatically. Any field below overrides the article's value."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo (override)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Recipe title (override)"
        },
        {
          "type": "product",
          "id": "best_with_product",
          "label": "Best-with potato",
          "info": "Shows as 'Best with {name}'. Leave empty to use the recipe article's featured product."
        },
        {
          "type": "text",
          "id": "variety_note",
          "label": "Variety note (override)",
          "info": "Free text that replaces the 'Best with' line entirely, e.g. Best with Maris Piper"
        },
        {
          "type": "text",
          "id": "cook_time",
          "label": "Cook time (override)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Recipe link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recipe feature",
      "blocks": [
        {
          "type": "recipe",
          "settings": {
            "title": "Triple-cooked chips",
            "variety_note": "Best with Maris Piper",
            "cook_time": "45 min"
          }
        },
        {
          "type": "recipe",
          "settings": {
            "title": "Roast potatoes with duck fat",
            "variety_note": "Best with King Edward",
            "cook_time": "1 hr 20 min"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%} Design hub — bespoke listing for the lighting design blog. Renamed from recipe-hub.liquid; CSS classes stay `rhub-*` internally (cosmetic only, not renamed this pass). {%- endcomment -%}
{{ 'morghew-recipe-hub.css' | asset_url | stylesheet_tag }}
{%- assign design_blog = blogs.design -%}
{%- liquid
  assign feat = blank
  for a in design_blog.articles
    if a.tags contains 'featured' or a.tags contains 'Featured'
      assign feat = a
      break
    endif
  endfor
  if feat == blank and design_blog.articles.size > 0
    assign feat = design_blog.articles.first
  endif
-%}

<div class="rhub">
  <section class="rhub-hero">
    {%- if section.settings.hero_image != blank -%}
      <img class="rhub-hero__bg" src="{{ section.settings.hero_image | image_url: width: 2400 }}" alt="" aria-hidden="true" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}" loading="eager">
    {%- endif -%}
    <div class="rhub-hero__overlay" style="background: rgba(20,16,12,{{ section.settings.hero_overlay | divided_by: 100.0 }});"></div>
    <div class="rhub-hero__inner rhub__wrap">
      {%- if section.settings.hero_eyebrow != blank -%}<p class="rhub-hero__eyebrow">{{ section.settings.hero_eyebrow }}</p>{%- endif -%}
      <h1 class="rhub-hero__title">{{ section.settings.hero_title | default: 'Recipes' }}</h1>
      {%- if section.settings.hero_sub != blank -%}<p class="rhub-hero__sub">{{ section.settings.hero_sub }}</p>{%- endif -%}
    </div>
  </section>

  <div class="rhub__wrap">
    {%- if feat != blank -%}
      {%- assign feat_designer = feat.metafields.custom.design_designer.value -%}
      <a class="rhub-feat" href="{{ feat.url }}">
        <div class="rhub-feat__media">
          {%- if feat.image -%}<img src="{{ feat.image | image_url: width: 1000 }}" alt="{{ feat.image.alt | default: feat.title | escape }}" loading="eager" fetchpriority="high" width="1000" height="750">{%- endif -%}
          <span class="rhub-feat__badge">Featured article</span>
          <span class="rhub-feat__strip">
            {%- if feat.metafields.custom.design_read_time != blank -%}<span>{%- render 'morghew-icon', icon: 'clock' -%}{{ feat.metafields.custom.design_read_time.value }}</span>{%- endif -%}
            {%- if feat.metafields.custom.design_area != blank -%}<span>Serves {{ feat.metafields.custom.design_area.value }}</span>{%- endif -%}
            {%- if feat.metafields.custom.design_style != blank -%}<span>{{ feat.metafields.custom.design_style.value }}</span>{%- endif -%}
          </span>
        </div>
        <div class="rhub-feat__body">
          {%- if feat_designer -%}<p class="rhub-feat__by">by {{ feat_designer.name.value }}</p>{%- endif -%}
          <h2 class="rhub-feat__title">{{ feat.title }}</h2>
          {%- assign feat_sub = feat.metafields.descriptors.subtitle.value -%}
          {%- if feat_sub != blank -%}<p class="rhub-feat__sub">{{ feat_sub }}</p>{%- endif -%}
          {%- assign feat_intro = feat.metafields.custom.design_summary.value -%}
          {%- if feat_intro != blank -%}<p class="rhub-feat__intro">{{ feat_intro | strip_html | truncatewords: 34 }}</p>{%- endif -%}
          {%- assign feat_methods = feat.metafields.custom.design_rooms -%}
          {%- if feat_methods != blank -%}<div class="rhub-feat__tags">{%- for m in feat_methods.value -%}<span class="rhub-tag">{{ m }}</span>{%- endfor -%}</div>{%- endif -%}
          <span class="rhub-feat__cta">Read article <span aria-hidden="true">&rarr;</span></span>
        </div>
      </a>
    {%- endif -%}
  </div>

  {%- assign room_list = 'Kitchen,Bathroom,Living Room,Bedroom,Outdoor,Hallway,Commercial' | split: ',' -%}
  {%- assign style_list = 'Modern,Classic,Industrial,Minimalist' | split: ',' -%}
  <div class="rhub-filters" id="rhub-filters-{{ section.id }}">
    <div class="rhub__wrap rhub-filters__inner">
      <div class="rhub-search">
        {%- render 'morghew-icon', icon: 'search' -%}
        <input type="search" class="rhub-search__input" id="rhub-q-{{ section.id }}" placeholder="Search by title or room…" aria-label="Search recipes">
      </div>
      <div class="rhub-filtergroup" data-group="room">
        <span class="rhub-filtergroup__label">Room</span>
        <button type="button" class="rhub-pill is-active" data-filter="room" data-value="all">All</button>
        {%- for m in room_list -%}<button type="button" class="rhub-pill" data-filter="room" data-value="{{ m | downcase }}">{{ m }}</button>{%- endfor -%}
      </div>
      <div class="rhub-filtergroup" data-group="style">
        <span class="rhub-filtergroup__label">Style</span>
        <button type="button" class="rhub-pill is-active" data-filter="style" data-value="all">All</button>
        {%- for d in style_list -%}<button type="button" class="rhub-pill" data-filter="style" data-value="{{ d | downcase }}">{{ d }}</button>{%- endfor -%}
      </div>
    </div>
  </div>
  <div class="rhub__wrap"><p class="rhub-count"><span id="rhub-count-{{ section.id }}">{{ design_blog.articles.size }}</span> recipes</p></div>

  <div class="rhub__wrap">
    <div class="rhub-grid" id="rhub-grid-{{ section.id }}">
      {%- for a in design_blog.articles -%}
        {%- assign a_designer = a.metafields.custom.design_designer.value -%}
        {%- assign a_diff = a.metafields.custom.design_style.value -%}
        {%- assign a_methods = a.metafields.custom.design_rooms -%}
        {%- capture a_method_data -%}{%- if a_methods != blank -%}{%- for m in a_methods.value -%}{{ m | downcase }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- endif -%}{%- endcapture -%}
        <a class="rhub-card" href="{{ a.url }}"
           data-title="{{ a.title | downcase | escape }} {{ a.metafields.descriptors.subtitle.value | downcase | escape }}"
           data-methods="{{ a_method_data }}"
           data-difficulty="{{ a_diff | downcase }}">
          <div class="rhub-card__media">
            {%- if a.image -%}<img src="{{ a.image | image_url: width: 600 }}" alt="{{ a.image.alt | default: a.title | escape }}" loading="lazy" width="600" height="450">{%- endif -%}
            <span class="rhub-card__overlay">
              {%- if a.metafields.custom.design_read_time != blank -%}<span>{%- render 'morghew-icon', icon: 'clock' -%}{{ a.metafields.custom.design_read_time.value }}</span>{%- endif -%}
              {%- if a.metafields.custom.design_area != blank -%}<span>Serves {{ a.metafields.custom.design_area.value }}</span>{%- endif -%}
            </span>
          </div>
          <div class="rhub-card__body">
            <div class="rhub-card__meta">
              {%- if a_diff != blank -%}<span class="rhub-card__diff"><span class="rhub-card__dot"></span>{{ a_diff }}</span>{%- endif -%}
              {%- if a_methods != blank -%}<span class="rhub-card__tags">{%- for m in a_methods.value -%}<span class="rhub-tag rhub-tag--sm">{{ m }}</span>{%- endfor -%}</span>{%- endif -%}
            </div>
            <h3 class="rhub-card__title">{{ a.title }}</h3>
            {%- assign a_sub = a.metafields.descriptors.subtitle.value -%}
            {%- if a_sub != blank -%}<p class="rhub-card__sub">{{ a_sub }}</p>{%- endif -%}
            {%- if a_designer -%}<p class="rhub-card__by">by {{ a_designer.name.value }}</p>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
      <p class="rhub-empty" id="rhub-empty-{{ section.id }}" hidden>No articles match those filters.</p>
    </div>
  </div>

  {%- assign all_designers = shop.metaobjects.designer.values -%}
  {%- if all_designers.size > 0 -%}
    <section class="rhub-chefs">
      <div class="rhub__wrap rhub-chefs__grid">
        <div class="rhub-chefs__head">
          {%- if section.settings.designers_eyebrow != blank -%}<p class="rhub-chefs__eyebrow">{{ section.settings.designers_eyebrow }}</p>{%- endif -%}
          {%- if section.settings.designers_heading != blank -%}<h2 class="rhub-chefs__heading">{{ section.settings.designers_heading }}</h2>{%- endif -%}
          {%- if section.settings.designers_intro != blank -%}<div class="rhub-chefs__intro">{{ section.settings.designers_intro }}</div>{%- endif -%}
        </div>
        <div class="rhub-chefs__list">
          {%- for c in all_designers -%}
            {%- assign n = 0 -%}
            {%- for a in design_blog.articles -%}
              {%- if a.metafields.custom.design_designer.value == c -%}{%- assign n = n | plus: 1 -%}{%- endif -%}
            {%- endfor -%}
            <div class="rhub-chef">
              {%- if c.portrait.value -%}<span class="rhub-chef__portrait"><img src="{{ c.portrait.value | image_url: width: 160 }}" alt="{{ c.name.value | escape }}" loading="lazy" width="80" height="80"></span>{%- endif -%}
              <div class="rhub-chef__body">
                <p class="rhub-chef__name">{{ c.name.value }}</p>
                {%- if c.role.value != blank -%}<p class="rhub-chef__role">{{ c.role.value }}</p>{%- endif -%}
                <p class="rhub-chef__count">{{ n }} article{% if n != 1 %}s{% endif %}</p>
              </div>
              {%- if c.instagram.value != blank -%}<a class="rhub-chef__ig" href="{{ c.instagram.value }}" target="_blank" rel="noopener" aria-label="{{ c.name.value | escape }} on Instagram">{%- render 'morghew-icon', icon: 'arrow' -%}</a>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.submit_heading != blank -%}
    <section class="rhub-submit">
      {%- if section.settings.submit_image != blank -%}<img class="rhub-submit__bg" src="{{ section.settings.submit_image | image_url: width: 2400 }}" alt="" aria-hidden="true" loading="lazy" width="{{ section.settings.submit_image.width }}" height="{{ section.settings.submit_image.height }}">{%- endif -%}
      <div class="rhub-submit__overlay"></div>
      <div class="rhub__wrap rhub-submit__inner">
        <div>
          {%- if section.settings.submit_eyebrow != blank -%}<p class="rhub-submit__eyebrow">{{ section.settings.submit_eyebrow }}</p>{%- endif -%}
          <h2 class="rhub-submit__heading">{{ section.settings.submit_heading }}</h2>
          {%- if section.settings.submit_text != blank -%}<p class="rhub-submit__text">{{ section.settings.submit_text }}</p>{%- endif -%}
        </div>
        {%- if section.settings.submit_btn_label != blank -%}<a class="rhub-submit__btn" href="{{ section.settings.submit_btn_url | default: '#' }}">{{ section.settings.submit_btn_label }}</a>{%- endif -%}
      </div>
    </section>
  {%- endif -%}
</div>

<script>
(function () {
  var sid = '{{ section.id }}';
  var q = document.getElementById('rhub-q-' + sid);
  var grid = document.getElementById('rhub-grid-' + sid);
  var countEl = document.getElementById('rhub-count-' + sid);
  var emptyEl = document.getElementById('rhub-empty-' + sid);
  if (!grid) return;
  var cards = Array.prototype.slice.call(grid.querySelectorAll('.rhub-card'));
  var state = { q: '', room: 'all', style: 'all' };
  var pills = document.querySelectorAll('#rhub-filters-' + sid + ' .rhub-pill');
  pills.forEach(function (p) {
    p.addEventListener('click', function () {
      var group = p.dataset.filter;
      document.querySelectorAll('#rhub-filters-' + sid + ' .rhub-pill[data-filter="' + group + '"]').forEach(function (b) { b.classList.remove('is-active'); });
      p.classList.add('is-active');
      state[group] = p.dataset.value;
      apply();
    });
  });
  if (q) q.addEventListener('input', function () { state.q = q.value.trim().toLowerCase(); apply(); });
  function apply() {
    var visible = 0;
    cards.forEach(function (card) {
      var okQ = !state.q || (card.dataset.title || '').indexOf(state.q) !== -1;
      var okM = state.room === 'all' || (',' + (card.dataset.methods || '') + ',').indexOf(',' + state.room + ',') !== -1;
      var okD = state.style === 'all' || (card.dataset.difficulty || '') === state.style;
      var show = okQ && okM && okD;
      card.classList.toggle('is-hidden', !show);
      if (show) visible++;
    });
    if (countEl) countEl.textContent = visible;
    if (emptyEl) emptyEl.hidden = visible !== 0;
  }
}());
</script>

{% schema %}
{
  "name": "Design hub",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero background image" },
    { "type": "range", "id": "hero_overlay", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 45 },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "From our design team" },
    { "type": "text", "id": "hero_title", "label": "Title", "default": "Design Ideas" },
    { "type": "textarea", "id": "hero_sub", "label": "Subtitle", "default": "Real rooms, real installs. Here's how we lit them." },
    { "type": "header", "content": "Our designers" },
    { "type": "text", "id": "designers_eyebrow", "label": "Eyebrow", "default": "Our designers" },
    { "type": "text", "id": "designers_heading", "label": "Heading", "default": "Ideas from our design team" },
    { "type": "richtext", "id": "designers_intro", "label": "Intro", "default": "<p>We work with lighting designers and installers who write up their own projects, sharing how they approached each room.</p>" },
    { "type": "header", "content": "Submit CTA" },
    { "type": "image_picker", "id": "submit_image", "label": "Background image" },
    { "type": "text", "id": "submit_eyebrow", "label": "Eyebrow", "default": "Share your project" },
    { "type": "text", "id": "submit_heading", "label": "Heading", "default": "Finished a project with us?" },
    { "type": "textarea", "id": "submit_text", "label": "Text", "default": "Send us photos and a few lines on the project, we'd love to feature it here." },
    { "type": "text", "id": "submit_btn_label", "label": "Button label", "default": "Submit a project" },
    { "type": "url", "id": "submit_btn_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Design hub" }]
}
{% endschema %}

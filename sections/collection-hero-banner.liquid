{%- comment -%}
  Collection hero banner — split layout (image left, title + description
  panel right), matching the reference supplier PLP pattern the client
  asked to replicate. Falls back to the collection's own Shopify image and
  description when no per-section override is set, so every collection
  gets a working banner with zero manual setup.
{%- endcomment -%}

{%- assign banner_image = section.settings.image | default: collection.featured_image -%}

<div class="colhero{% unless banner_image %} colhero--no-image{% endunless %}">
  <div class="colhero__row">
    {%- if banner_image -%}
      <div class="colhero__media">
        <img
          src="{{ banner_image | image_url: width: 1600 }}"
          srcset="{{ banner_image | image_url: width: 800 }} 800w, {{ banner_image | image_url: width: 1600 }} 1600w"
          sizes="(min-width: 750px) 55vw, 100vw"
          alt="{{ banner_image.alt | default: collection.title | escape }}"
          width="{{ banner_image.width }}"
          height="{{ banner_image.height }}"
          loading="eager"
          fetchpriority="high">
      </div>
    {%- endif -%}
    <div class="colhero__content">
      <nav class="colhero__crumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="{{ routes.all_products_collection_url }}">Shop</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span>{{ collection.title }}</span>
      </nav>
      <h1 class="colhero__title">{{ section.settings.heading | default: collection.title }}</h1>
      {%- if section.settings.description != blank -%}
        <div class="colhero__desc">{{ section.settings.description }}</div>
      {%- elsif collection.description != blank -%}
        <div class="colhero__desc">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .colhero { background: var(--paper); }
  .colhero__row {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    min-height: 360px;
  }
  .colhero--no-image .colhero__row { grid-template-columns: 1fr; }
  .colhero__media { position: relative; overflow: hidden; }
  .colhero__media img {
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
    display: block;
  }
  .colhero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px clamp(28px, 5vw, 72px);
    background: linear-gradient(120deg, var(--card), var(--paper));
  }
  .colhero__crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--ink-soft);
    margin-bottom: 18px;
  }
  .colhero__crumb a { color: var(--ink-soft); text-decoration: none; }
  .colhero__crumb a:hover { color: var(--ink); text-decoration: underline; }
  .colhero__crumb span:last-child { color: var(--ink); }
  .colhero__title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.08;
    color: var(--ink);
    margin: 0 0 16px;
  }
  .colhero__desc {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 56ch;
  }
  .colhero__desc p { margin: 0 0 12px; }
  .colhero__desc p:last-child { margin-bottom: 0; }

  @media screen and (max-width: 749px) {
    .colhero__row { grid-template-columns: 1fr; }
    .colhero__media { display: none; }
    .colhero__content { padding: 32px 20px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Collection hero banner",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner image", "info": "Optional. Leave empty to use the collection's own image, or none for a text-only banner." },
    { "type": "text", "id": "heading", "label": "Heading override", "info": "Leave empty to use the collection title." },
    { "type": "richtext", "id": "description", "label": "Description override", "info": "Leave empty to use the collection's own description." }
  ]
}
{% endschema %}

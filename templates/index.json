        "review_2": {
          "type": "review",
          "settings": {
            "quote": "We needed a complex design produced very quickly. Vivid hold a lot of off-the-shelf kit so could deliver within our allotted timeframe, to the quality we expected and required. Their standard of work throughout was excellent, as was their communication and professionalism.",
            "stars": 5,
            "name": "David Keane",
            "meta": "Senior Production Manager"
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "quote": "It's been great working with Lee, Rupert and the wider team. I can't recommend the team at Vivid enough and we will be using them again in the future.",
